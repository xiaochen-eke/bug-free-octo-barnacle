# ============================================================================
# 数据模型
# ============================================================================

class TranslationRequest(BaseModel):
    """翻译请求"""
    text: str
    source_language: str = "en"
    target_language: str = "zh"

class TranslationResponse(BaseModel):
    """翻译响应"""
    original_text: str
    translated_text: str
    source_language: str
    target_language: str
    confidence: float = 0.95

class BatchTranslationRequest(BaseModel):
    """批量翻译请求"""
    texts: List[str]
    source_language: str = "en"
    target_language: str = "zh"

class LanguageListResponse(BaseModel):
    """语言列表响应"""
    languages: Dict[str, str]

class ModelInfoResponse(BaseModel):
    """模型信息响应"""
    model_name: str
    supported_languages: List[str]
    language_pairs: List[Dict[str, str]]
    parameters: int

# ============================================================================
# 全局变量
# ============================================================================

# 设备
device = 'cuda' if torch.cuda.is_available() else 'cpu'
logger.info(f"Using device: {device}")

# 翻译器（动态加载）
translators: Dict[str, Translator] = {}
vocabularies: Dict[str, Vocabulary] = {}

# 支持的语言和语言对
SUPPORTED_LANGUAGES = {
    'zh': 'Chinese',
    'en': 'English',
    'ja': 'Japanese',
    'fr': 'French',
    'de': 'German'
}

LANGUAGE_PAIRS = [
    ('zh', 'en'), ('zh', 'ja'), ('zh', 'fr'), ('zh', 'de'),
    ('en', 'zh'), ('en', 'ja'), ('en', 'fr'), ('en', 'de'),
    ('ja', 'zh'), ('ja', 'en'), ('ja', 'fr'), ('ja', 'de'),
    ('fr', 'zh'), ('fr', 'en'), ('fr', 'ja'), ('fr', 'de'),
    ('de', 'zh'), ('de', 'en'), ('de', 'ja'), ('de', 'fr'),
]

# ============================================================================
# 模型加载和初始化
# ============================================================================

def load_vocabularies(vocab_dir: str = './vocab'):
    """加载词汇表"""
    global vocabularies
    vocab_path = Path(vocab_dir)
    
    if not vocab_path.exists():
        logger.warning(f"Vocabulary directory {vocab_dir} does not exist")
        return
    
    import pickle
    for lang_file in vocab_path.glob('vocab_*.pkl'):
        lang = lang_file.stem.replace('vocab_', '')
        try:
            with open(lang_file, 'rb') as f:
                data = pickle.load(f)
                vocab = Vocabulary()
                vocab.word2idx = data['word2idx']
                vocab.idx2word = data['idx2word']
                vocab.word_freq = data['word_freq']
                vocab.min_freq = data['min_freq']
                vocabularies[lang] = vocab
                logger.info(f"Loaded vocabulary for {lang}")
        except Exception as e:
            logger.error(f"Failed to load vocabulary for {lang}: {e}")

def load_model(model_dir: str = './checkpoints', lang_pair: tuple = ('en', 'zh')):
    """加载翻译模型"""
    src_lang, tgt_lang = lang_pair
    pair_key = f"{src_lang}_{tgt_lang}"
    
    if pair_key in translators:
        return translators[pair_key]
    
    try:
        model_path = Path(model_dir) / f'model_{pair_key}.pt'
        config_path = Path(model_dir) / f'config_{pair_key}.json'
        
        # 如果模型文件不存在，创建一个虚拟模型用于演示
        if not model_path.exists():
            logger.warning(f"Model file {model_path} not found, creating dummy model")
            
            # 从配置创建模型（如果存在）
            if config_path.exists():
                with open(config_path, 'r') as f:
                    config_dict = json.load(f)
                config = TransformerConfig.from_dict(config_dict)
            else:
                # 使用默认配置
                config = TransformerConfig(
                    src_vocab_size=len(vocabularies.get(src_lang, Vocabulary())),
                    tgt_vocab_size=len(vocabularies.get(tgt_lang, Vocabulary())),
                    d_model=512,
                    num_layers=6,
                    num_heads=8,
                    d_ff=2048,
                    max_seq_len=128,
                    dropout=0.1
                )
            
            model = Transformer(
                src_vocab_size=config.src_vocab_size,
                tgt_vocab_size=config.tgt_vocab_size,
                d_model=config.d_model,
                num_layers=config.num_layers,
                num_heads=config.num_heads,
                d_ff=config.d_ff,
                max_seq_len=config.max_seq_len,
                dropout=config.dropout
            )
        else:
            # 加载已有模型
            checkpoint = torch.load(model_path, map_location=device)
            
            if config_path.exists():
                with open(config_path, 'r') as f:
                    config_dict = json.load(f)
                config = TransformerConfig.from_dict(config_dict)
            else:
                config = TransformerConfig()
            
            model = Transformer(
                src_vocab_size=config.src_vocab_size,
                tgt_vocab_size=config.tgt_vocab_size,
                d_model=config.d_model,
                num_layers=config.num_layers,
                num_heads=config.num_heads,
                d_ff=config.d_ff,
                max_seq_len=config.max_seq_len,
                dropout=config.dropout
            )
            
            if isinstance(checkpoint, dict) and 'model_state_dict' in checkpoint:
                model.load_state_dict(checkpoint['model_state_dict'])
            else:
                model.load_state_dict(checkpoint)
            
            logger.info(f"Loaded model for {pair_key}")
        
        # 创建翻译器
        src_vocab = vocabularies.get(src_lang, Vocabulary())
        tgt_vocab = vocabularies.get(tgt_lang, Vocabulary())
        
        translator = Translator(
            model=model,
            src_vocab=src_vocab,
            tgt_vocab=tgt_vocab,
            device=device,
            max_seq_len=128,
            beam_size=5
        )
        
        translators[pair_key] = translator
        logger.info(f"Created translator for {pair_key}")
        
        return translator
    
    except Exception as e:
        logger.error(f"Failed to load model for {lang_pair}: {e}")
        raise

