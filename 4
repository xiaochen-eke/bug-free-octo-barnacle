            {"source": src, "target": tgt}
            for src, tgt in LANGUAGE_PAIRS
        ]
    }

@app.get("/model-info", response_model=ModelInfoResponse)
async def get_model_info():
    """获取模型信息"""
    total_params = 0
    
    if translators:
        translator = next(iter(translators.values()))
        total_params = sum(p.numel() for p in translator.model.parameters())
    
    language_pairs = [
        {"source": src, "target": tgt}
        for src, tgt in LANGUAGE_PAIRS
    ]
    
    return {
        "model_name": "Transformer-based Multilingual Translation",
        "supported_languages": list(SUPPORTED_LANGUAGES.keys()),
        "language_pairs": language_pairs,
        "parameters": total_params
    }

# ============================================================================
# 翻译接口
# ============================================================================

@app.post("/translate", response_model=TranslationResponse)
async def translate(request: TranslationRequest):
    """翻译单个文本"""
    
    # 验证语言对
    if request.source_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported source language: {request.source_language}")
    if request.target_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported target language: {request.target_language}")
    
    if (request.source_language, request.target_language) not in LANGUAGE_PAIRS:
        raise HTTPException(status_code=400, detail=f"Language pair not supported")
    
    try:
        # 加载翻译器
        translator = load_model(
            lang_pair=(request.source_language, request.target_language)
        )
        
        # 翻译
        translated_text = translator.translate(request.text, request.source_language)
        
        return {
            "original_text": request.text,
            "translated_text": translated_text,
            "source_language": request.source_language,
            "target_language": request.target_language,
            "confidence": 0.95
        }
    
    except Exception as e:
        logger.error(f"Translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/translate-batch")
async def translate_batch(request: BatchTranslationRequest):
    """批量翻译"""
    
    # 验证语言对
    if request.source_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported source language: {request.source_language}")
    if request.target_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported target language: {request.target_language}")
    
    if (request.source_language, request.target_language) not in LANGUAGE_PAIRS:
        raise HTTPException(status_code=400, detail=f"Language pair not supported")
    
    try:
        # 加载翻译器
        translator = load_model(
            lang_pair=(request.source_language, request.target_language)
        )
        
        # 批量翻译
        results = []
        for text in request.texts:
            translated_text = translator.translate(text, request.source_language)
            results.append({
                "original_text": text,
                "translated_text": translated_text,
                "source_language": request.source_language,
                "target_language": request.target_language
            })
        
        return {"results": results}
    
    except Exception as e:
        logger.error(f"Batch translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

# ============================================================================
# 文件上传和翻译
# ============================================================================

@app.post("/translate-file")
async def translate_file(
    file: UploadFile = File(...),
    source_language: str = "en",
    target_language: str = "zh"
):
    """翻译文本文件"""
    
    # 验证语言对
    if source_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported source language: {source_language}")
    if target_language not in SUPPORTED_LANGUAGES:
        raise HTTPException(status_code=400, detail=f"Unsupported target language: {target_language}")
    
    if (source_language, target_language) not in LANGUAGE_PAIRS:
        raise HTTPException(status_code=400, detail=f"Language pair not supported")
    
    try:
        # 读取文件
        content = await file.read()
        text = content.decode('utf-8')
        
        # 按行分割
        lines = text.strip().split('\n')
        
        # 加载翻译器
        translator = load_model(
            lang_pair=(source_language, target_language)
        )
        
        # 翻译每一行
        translated_lines = []
        for line in lines:
            if line.strip():
                translated_line = translator.translate(line, source_language)
                translated_lines.append(translated_line)
            else:
                translated_lines.append("")
        
        # 返回翻译结果
        translated_content = '\n'.join(translated_lines)
        
        return {
            "original_filename": file.filename,
            "translated_content": translated_content,
            "source_language": source_language,
            "target_language": target_language,
            "lines_translated": len([l for l in lines if l.strip()])
        }
    
    except Exception as e:
        logger.error(f"File translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

