def load_sample_data():
    """
    加载样本数据 (中英翻译对)
    在实际项目中，这些数据应该来自真实的翻译语料库
    """
    # 中英翻译对 (简单示例)
    data = [
        ("你好", "Hello"),
        ("早上好", "Good morning"),
        ("谢谢", "Thank you"),
        ("对不起", "Sorry"),
        ("没问题", "No problem"),
        ("你好吗", "How are you"),
        ("很好", "Very well"),
        ("我是学生", "I am a student"),
        ("这是一本书", "This is a book"),
        ("今天天气很好", "The weather is nice today"),
        ("我喜欢阅读", "I like reading"),
        ("他住在北京", "He lives in Beijing"),
        ("你想喝茶吗", "Would you like some tea"),
        ("我很高兴", "I am very happy"),
        ("晚安", "Good night"),
