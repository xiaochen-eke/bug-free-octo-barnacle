<script setup>
import { ref, computed, onMounted, watch } from 'vue'
import axios from 'axios'

// ==================== 状态管理 ====================
const sourceText = ref('')
const translatedText = ref('')
const sourceLanguage = ref('zh')
const targetLanguage = ref('en')
const translating = ref(false)
const modelLoaded = ref(false)
const loadingStatus = ref('初始化中...')
const error = ref(null)
const success = ref(null)
const translationMethod = ref('greedy')
const translationHistory = ref([])
const batchResults = ref([])
const selectedFile = ref(null)
const lastProcessingTime = ref(0)
const modelInfo = ref({
  parameters: '未加载',
  device: '未知'
})

// API基础URL
const API_BASE_URL = 'http://localhost:8000/api'

// ==================== 计算属性 ====================
const langPair = computed(() => `${sourceLanguage.value}-${targetLanguage.value}`)

// ==================== 方法 ====================

/**
 * 初始化应用
 */
const initApp = async () => {
  try {
    loadingStatus.value = '检查服务连接...'
    
    // 检查健康状态
    const healthResponse = await axios.get('http://localhost:8000/health')
    console.log('服务状态:', healthResponse.data)
    
    loadingStatus.value = '加载模型...'
    
    // 加载模型
    const loadResponse = await axios.post(`${API_BASE_URL}/models/load`, {
      model_path: './opus_zh-en_model.pth',
      tokenizer_path: './opus_zh-en_tokenizers',
      lang_pair: 'zh-en'
    })
    
    loadingStatus.value = '获取模型信息...'
    
    // 获取模型状态
    const statusResponse = await axios.get(`${API_BASE_URL}/models/status`)
    const status = statusResponse.data
    
    modelInfo.value = {
      parameters: formatNumber(status.parameters),
      device: status.device
    }
    
    modelLoaded.value = true
    success.value = '✓ 模型加载成功！'
    setTimeout(() => success.value = null, 3000)
  } catch (err) {
    console.error('初始化失败:', err)
    error.value = `初始化失败: ${err.message}`
    // 仍然允许继续（可以离线测试）
    setTimeout(() => {
      modelLoaded.value = true
    }, 3000)
  }
}

/**
 * 翻译文本
 */
const translate = async () => {
  if (!sourceText.value.trim()) {
    error.value = '请输入要翻译的文本'
    return
  }

  if (!modelLoaded.value) {
    error.value = '模型未加载，请稍候...'
    return
  }

  translating.value = true
  error.value = null

  try {
    const startTime = Date.now()
    
    const response = await axios.post(`${API_BASE_URL}/translate`, {
      text: sourceText.value,
      source_lang: sourceLanguage.value,
      target_lang: targetLanguage.value,
      method: translationMethod.value
    })

    const data = response.data
    translatedText.value = data.translated_text
    lastProcessingTime.value = Math.round(Date.now() - startTime)

    // 保存到历史
    translationHistory.value.push({
      sourceText: sourceText.value,
      translatedText: translatedText.value,
      sourceLanguage: sourceLanguage.value,
      targetLanguage: targetLanguage.value,
      timestamp: new Date(),
      processingTime: lastProcessingTime.value
    })

    success.value = `✓ 翻译完成 (${lastProcessingTime.value}ms)`
    setTimeout(() => success.value = null, 3000)
  } catch (err) {
    console.error('翻译错误:', err)
    error.value = `翻译失败: ${err.response?.data?.detail || err.message}`
  } finally {
    translating.value = false
  }
}

/**
 * 交换源目标语言
 */
const toggleLanguages = () => {
  [sourceLanguage.value, targetLanguage.value] = 
    [targetLanguage.value, sourceLanguage.value];
  [sourceText.value, translatedText.value] = 
    [translatedText.value, sourceText.value]
}

/**
 * 清空源文本
 */
const clearSource = () => {
  sourceText.value = ''
  translatedText.value = ''
}

/**
 * 复制到剪贴板
 */
const copyToClipboard = async () => {
  try {
    await navigator.clipboard.writeText(translatedText.value)
    success.value = '✓ 已复制到剪贴板'
    setTimeout(() => success.value = null, 2000)
  } catch (err) {
    error.value = '复制失败'
  }
}

/**
 * 源文本输入处理
 */
const onSourceTextInput = () => {
  if (sourceText.value.length > 5000) {
    sourceText.value = sourceText.value.substring(0, 5000)
    error.value = '文本长度不能超过5000字符'
  }
}

/**
 * 选择历史项
 */
const selectHistoryItem = (item) => {
  sourceText.value = item.sourceText
  translatedText.value = item.translatedText
  sourceLanguage.value = item.sourceLanguage
  targetLanguage.value = item.targetLanguage
}

/**
 * 文件上传处理
 */
const handleFileUpload = (event) => {
  selectedFile.value = event.target.files[0]
}

/**
 * 上传文件翻译
 */
const uploadFile = async () => {
  if (!selectedFile.value) {
    error.value = '请选择文件'
    return
  }

  translating.value = true
  error.value = null
  batchResults.value = []

  try {
    const formData = new FormData()
    formData.append('file', selectedFile.value)
    formData.append('source_lang', sourceLanguage.value)
    formData.append('target_lang', targetLanguage.value)
    formData.append('method', translationMethod.value)

    const response = await axios.post(
      `${API_BASE_URL}/translate/file`,
      formData,
      {
        headers: {
          'Content-Type': 'multipart/form-data'
        }
      }
    )

    const data = response.data
    batchResults.value = data.translated_sentences.map((trans, idx) => ({
      source_text: data.original_sentences[idx],
      translated_text: trans
    }))

    success.value = `✓ 文件翻译完成，共${data.total_sentences}句`
    setTimeout(() => success.value = null, 3000)
  } catch (err) {
    console.error('文件上传错误:', err)
    error.value = `文件上传失败: ${err.message}`
  } finally {
    translating.value = false
  }
}

/**
 * 格式化数字
 */
const formatNumber = (num) => {
  if (num >= 1000000) {
    return (num / 1000000).toFixed(1) + 'M'
  } else if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'K'
  }
  return num.toString()
}

/**
 * 格式化时间
 */
const formatTime = (date) => {
  const now = new Date()
  const diff = now - date
  const seconds = Math.floor(diff / 1000)
  
  if (seconds < 60) return '刚刚'
  if (seconds < 3600) return Math.floor(seconds / 60) + '分钟前'
  if (seconds < 86400) return Math.floor(seconds / 3600) + '小时前'
  
  return date.toLocaleDateString()
}

/**
 * 显示关于信息
 */
const showAbout = () => {
  alert('Transformer 机器翻译系统\n基于深度学习的神经机器翻译\nv1.0.0')
}

/**
 * 显示API文档
 */
const showAPI = () => {
  window.open('http://localhost:8000/docs', '_blank')
}

/**
 * 显示帮助
 */
const showHelp = () => {
  alert(`
使用说明:
1. 在左侧输入要翻译的文本
2. 选择源语言和目标语言
3. 点击"翻译"按钮
4. 在右侧查看翻译结果

支持的功能:
- 单句翻译
- 批量文件翻译
- 翻译历史
- 两种解码方式 (贪心 / 束搜索)

快捷操作:
- 点击⇄按钮可交换源目标语言
- 点击历史记录快速重新翻译
  `)
}

// ==================== 生命周期 ====================
onMounted(() => {
  initApp()
})

// 自动翻译（可选）
watch([sourceText, sourceLanguage, targetLanguage], () => {
  if (sourceText.value && sourceText.value.length < 200) {
    // 可选：自动翻译短文本
    // translate()
  }
})
</script>

