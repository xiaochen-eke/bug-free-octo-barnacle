class Translator:
    """翻译器"""
    
    def __init__(self,
                 model: Transformer,
                 src_vocab: Vocabulary,
                 tgt_vocab: Vocabulary,
                 device: str = 'cuda' if torch.cuda.is_available() else 'cpu',
                 max_seq_len: int = 128,
                 beam_size: int = 5):
        
        self.model = model.to(device)
        self.src_vocab = src_vocab
        self.tgt_vocab = tgt_vocab
        self.device = device
        self.max_seq_len = max_seq_len
        self.beam_size = beam_size
        
        self.model.eval()
    
    def translate_greedy(self, src_tokens: List[str], src_lang: str) -> str:
        """贪心搜索翻译"""
        # 编码源文本
        src_indices = self.src_vocab.encode(src_tokens)
        src_tensor = torch.tensor([src_indices], dtype=torch.long).to(self.device)
        
        with torch.no_grad():
            # 编码
            encoder_output = self.model.encode(src_tensor)
            
            # 初始化目标序列为<bos>
            bos_idx = self.tgt_vocab.word2idx[Vocabulary.BOS_TOKEN]
            eos_idx = self.tgt_vocab.word2idx[Vocabulary.EOS_TOKEN]
            pad_idx = self.tgt_vocab.word2idx[Vocabulary.PAD_TOKEN]
            
            tgt_indices = [bos_idx]
            
            # 逐个生成令牌
            for _ in range(self.max_seq_len):
                tgt_tensor = torch.tensor([tgt_indices], dtype=torch.long).to(self.device)
                
                # 解码
                logits = self.model.decode(
                    tgt_tensor,
                    encoder_output,
                    tgt_mask=None,
                    src_mask=None
                )
                
                # 取最后一个位置的最高概率令牌
                next_token_logits = logits[0, -1, :]
                next_token = torch.argmax(next_token_logits).item()
                
                if next_token == eos_idx:
                    break
                
                tgt_indices.append(next_token)
            
            # 解码为文本
            tgt_tokens = self.tgt_vocab.decode(tgt_indices[1:])  # 移除<bos>
            return ' '.join(tgt_tokens)
    
    def translate(self, src_text: str, src_lang: str) -> str:
        """翻译句子"""
        # 分词
        from data_processor import MultilingualTokenizer
        tokenizer = MultilingualTokenizer()
        src_tokens = tokenizer.tokenize(src_text, src_lang)
        
        # 翻译
        return self.translate_greedy(src_tokens, src_lang)


