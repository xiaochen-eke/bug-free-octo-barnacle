# ============================================================================
# 学习率调度器
# ============================================================================

class WarmupScheduler:
    """带预热的学习率调度器"""
    
    def __init__(self, optimizer: optim.Optimizer, d_model: int, warmup_steps: int = 4000):
        """
        Args:
            optimizer: PyTorch优化器
            d_model: 模型维度
            warmup_steps: 预热步数
        """
        self.optimizer = optimizer
        self.d_model = d_model
        self.warmup_steps = warmup_steps
        self.current_step = 0
    
    def step(self):
        """更新学习率"""
        self.current_step += 1
        lr = self._get_lr()
        for param_group in self.optimizer.param_groups:
            param_group['lr'] = lr
    
    def _get_lr(self) -> float:
        """计算当前学习率"""
        return self.d_model ** (-0.5) * min(
            self.current_step ** (-0.5),
            self.current_step * (self.warmup_steps ** (-1.5))
        )
    
    def get_last_lr(self) -> List[float]:
        """获取最后的学习率"""
        return [group['lr'] for group in self.optimizer.param_groups]


# ============================================================================
# 损失函数
# ============================================================================

class TranslationLoss(nn.Module):
    """翻译任务的损失函数"""
    
    def __init__(self, vocab_size: int, padding_idx: int = 0, smoothing: float = 0.1):
        """
        Args:
            vocab_size: 词汇表大小
            padding_idx: padding标记的索引
            smoothing: 标签平滑系数
        """
        super().__init__()
        self.vocab_size = vocab_size
        self.padding_idx = padding_idx
        self.smoothing = smoothing
        
        if smoothing > 0:
            self.criterion = self._create_label_smoothing_loss(vocab_size, padding_idx, smoothing)
        else:
            self.criterion = nn.CrossEntropyLoss(
                ignore_index=padding_idx,
                reduction='mean'
            )
    
    @staticmethod
    def _create_label_smoothing_loss(vocab_size: int, padding_idx: int, smoothing: float):
        """创建带标签平滑的损失函数"""
        return nn.CrossEntropyLoss(
            ignore_index=padding_idx,
            reduction='mean',
            label_smoothing=smoothing
        )
    
    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
        """
        Args:
            logits: (batch_size, seq_len, vocab_size)
            targets: (batch_size, seq_len)
        Returns:
            loss: 标量张量
        """
        # 重塑为(batch_size * seq_len, vocab_size)和(batch_size * seq_len)
        logits_reshaped = logits.view(-1, self.vocab_size)
        targets_reshaped = targets.view(-1)
        
        return self.criterion(logits_reshaped, targets_reshaped)


# ============================================================================
# BLEU分数计算
# ============================================================================

class BLEUScorer:
    """BLEU分数计算器"""
    
    @staticmethod
    def _get_ngrams(segment: List[str], max_order: int) -> Dict[Tuple, int]:
        """获取n-gram"""
        ngram_counts = defaultdict(int)
        for order in range(1, max_order + 1):
            for i in range(0, len(segment) - order + 1):
                ngram = tuple(segment[i:i + order])
                ngram_counts[ngram] += 1
        return ngram_counts
    
    @staticmethod
    def corpus_bleu(list_of_references: List[List[List[str]]],
                   hypotheses: List[List[str]],
                   max_order: int = 4,
                   smooth: bool = False) -> float:
        """
        计算语料库级别的BLEU分数
        
        Args:
            list_of_references: 参考翻译列表，格式为[[[ref1_1, ref1_2, ...]], [[ref2_1, ref2_2, ...]]]
            hypotheses: 假设翻译列表，格式为[[hyp1_1, hyp1_2, ...], [hyp2_1, hyp2_2, ...]]
            max_order: 最大n-gram阶数
            smooth: 是否使用平滑
        
        Returns:
            BLEU分数（0-1之间）
        """
        matches_by_order = [0] * max_order
        possible_matches_by_order = [0] * max_order
        reference_length = 0
        hypothesis_length = 0
        
        for (references, hypothesis) in zip(list_of_references, hypotheses):
            reference_length += min(len(r) for r in references)
            hypothesis_length += len(hypothesis)
            
            merged_ref_ngram_counts = defaultdict(int)
            for reference in references:
                reference_ngrams = BLEUScorer._get_ngrams(reference, max_order)
                for ngram in reference_ngrams:
                    merged_ref_ngram_counts[ngram] = max(
                        merged_ref_ngram_counts[ngram],
                        reference_ngrams[ngram]
                    )
            
            hypothesis_ngrams = BLEUScorer._get_ngrams(hypothesis, max_order)
            overlap = defaultdict(int)
            for ngram in hypothesis_ngrams:
                overlap[ngram] = min(hypothesis_ngrams[ngram],
                                    merged_ref_ngram_counts.get(ngram, 0))
            
            for order in range(1, max_order + 1):
                possible_matches = len(hypothesis) - order + 1
                if possible_matches > 0:
                    matches = sum(overlap.get(ngram, 0)
                                for ngram in overlap
                                if len(ngram) == order)
                    matches_by_order[order - 1] += matches
                    possible_matches_by_order[order - 1] += possible_matches
        
        precisions = [0] * max_order
        for i in range(0, max_order):
            if smooth:
                precisions[i] = ((matches_by_order[i] + 1.) /
                               (possible_matches_by_order[i] + 1.))
            else:
                if possible_matches_by_order[i] > 0:
                    precisions[i] = (float(matches_by_order[i]) /
                                   possible_matches_by_order[i])
                else:
                    precisions[i] = 0.0
        
        if min(precisions) > 0:
            p_log_sum = sum((1. / max_order) * math.log(p) for p in precisions)
            geo_mean = math.exp(p_log_sum)
        else:
            geo_mean = 0
        
        ratio = float(hypothesis_length) / reference_length if reference_length > 0 else 0
        
        if ratio > 1.0:
            bp = 1.
        elif ratio > 0:
            bp = math.exp(1 - 1. / ratio)
        else:
            bp = 0.0
        
        bleu = geo_mean * bp
        return bleu


