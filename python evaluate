class BLEUScore:
    """BLEU 分数计算"""
    
    @staticmethod
    def calculate_bleu(pred_tokens: List[int], ref_tokens: List[int], n=4) -> float:
        """计算 BLEU 分数"""
        if len(pred_tokens) == 0 or len(ref_tokens) == 0:
            return 0.0

        pred_tokens = [t for t in pred_tokens if t > 0]
        ref_tokens = [t for t in ref_tokens if t > 0]

        if len(pred_tokens) == 0:
            return 0.0

        bleu_scores = []
        for gram_n in range(1, min(n, len(pred_tokens)) + 1):
            pred_grams = set()
            ref_grams = set()

            for i in range(len(pred_tokens) - gram_n + 1):
                pred_grams.add(tuple(pred_tokens[i:i+gram_n]))

            for i in range(len(ref_tokens) - gram_n + 1):
                ref_grams.add(tuple(ref_tokens[i:i+gram_n]))

            if len(ref_grams) == 0:
                bleu_scores.append(0.0)
            else:
                precision = len(pred_grams & ref_grams) / len(ref_grams)
                bleu_scores.append(precision)

        if all(s > 0 for s in bleu_scores):
            bleu = np.exp(np.mean(np.log(bleu_scores)))
        else:
            bleu = 0.0

        return bleu

    @staticmethod
    def batch_bleu(predictions, targets):
        """批量计算BLEU"""
        batch_bleu = []
        for pred, tgt in zip(predictions, targets):
            pred_tokens = pred.tolist()
            tgt_tokens = tgt.tolist()
            bleu = BLEUScore.calculate_bleu(pred_tokens, tgt_tokens)
            batch_bleu.append(bleu)
        return np.mean(batch_bleu) if batch_bleu else 0.0


class CERScore:
    """字符错误率 (Character Error Rate)"""
    
    @staticmethod
    def calculate_cer(pred_tokens: List[int], ref_tokens: List[int]) -> float:
        """
        计算 CER
        可用于多语言，不需要tokenizer逆过程
        """
        if len(ref_tokens) == 0:
            return 0.0 if len(pred_tokens) == 0 else 1.0

        # 简化版本：用token序列计算编辑距离
        return CERScore.edit_distance(pred_tokens, ref_tokens) / len(ref_tokens)

    @staticmethod
    def edit_distance(s1, s2):
        """编辑距离 (Levenshtein)"""
        if len(s1) < len(s2):
            return CERScore.edit_distance(s2, s1)

        if len(s2) == 0:
            return len(s1)

        previous_row = range(len(s2) + 1)
        for i, c1 in enumerate(s1):
            current_row = [i + 1]
            for j, c2 in enumerate(s2):
                insertions = previous_row[j + 1] + 1
                deletions = current_row[j] + 1
                substitutions = previous_row[j] + (c1 != c2)
                current_row.append(min(insertions, deletions, substitutions))
            previous_row = current_row

        return previous_row[-1]

    @staticmethod
    def batch_cer(predictions, targets):
        """批量计算CER"""
        batch_cer = []
        for pred, tgt in zip(predictions, targets):
            pred_tokens = [t for t in pred.tolist() if t > 0]
            tgt_tokens = [t for t in tgt.tolist() if t > 0]
            cer = CERScore.calculate_cer(pred_tokens, tgt_tokens)
            batch_cer.append(cer)
        return np.mean(batch_cer) if batch_cer else 0.0


class Accuracy:
    """准确率指标"""
    
    @staticmethod
    def token_accuracy(predictions, targets, pad_idx=0):
        """逐token准确率"""
        mask = (targets != pad_idx).float()
        correct = (predictions == targets).float() * mask
        accuracy = correct.sum() / mask.sum().clamp(min=1e-8)
        return accuracy.item()

    @staticmethod
    def sequence_accuracy(predictions, targets, pad_idx=0):
        """序列级别准确率（整个序列都对才算对）"""
        mask = (targets != pad_idx).float()
        correct_per_seq = ((predictions == targets).float() * mask).sum(dim=1)
        total_per_seq = mask.sum(dim=1)
        seq_correct = (correct_per_seq == total_per_seq).float()
        return seq_correct.mean().item()


class Perplexity:
    """困惑度"""
    
    @staticmethod
    def calculate_ppl(loss):
        """从loss计算PPL"""
        return torch.exp(torch.tensor(loss)).item()


