class Evaluator:
    """多指标评估器"""
    
    def __init__(self, model, device, vocab_size):
        self.model = model
        self.device = device
        self.vocab_size = vocab_size
        self.model.eval()
    
    def evaluate(self, data_loader, criterion=None):
        """
        评估数据集
        返回各种指标
        """
        metrics = {
            'total_loss': 0,
            'total_bleu': 0,
            'total_cer': 0,
            'total_token_acc': 0,
            'total_seq_acc': 0,
            'num_batches': 0,
            'by_lang_pair': defaultdict(lambda: {
                'loss': [],
                'bleu': [],
                'cer': [],
                'token_acc': [],
                'seq_acc': [],
                'count': 0
            })
        }
        
        with torch.no_grad():
            for batch_idx, batch in enumerate(data_loader):
                src = batch["src"].to(self.device)
                tgt = batch["tgt"].to(self.device)
                lang_pairs = batch.get("lang_pair", ["unknown"] * len(src))
                
                tgt_input = tgt[:, :-1]
                tgt_output = tgt[:, 1:]
                
                # 前向传播
                logits = self.model(src, tgt_input)
                
                # Loss
                if criterion is not None:
                    loss = criterion(
                        logits.reshape(-1, self.vocab_size),
                        tgt_output.reshape(-1)
                    ).item()
                else:
                    loss = 0.0
                
                # 预测
                predictions = logits.argmax(dim=-1)
                
                # 计算各个指标
                bleu = BLEUScore.batch_bleu(predictions, tgt_output)
                cer = CERScore.batch_cer(predictions, tgt_output)
                token_acc = Accuracy.token_accuracy(predictions, tgt_output)
                seq_acc = Accuracy.sequence_accuracy(predictions, tgt_output)
                
                # 累加指标
                metrics['total_loss'] += loss
                metrics['total_bleu'] += bleu
                metrics['total_cer'] += cer
                metrics['total_token_acc'] += token_acc
                metrics['total_seq_acc'] += seq_acc
                metrics['num_batches'] += 1
                
                # 按语言对统计
                for i, lang_pair in enumerate(lang_pairs):
                    pred_seq = predictions[i].tolist()
                    tgt_seq = tgt_output[i].tolist()
                    
                    bleu_i = BLEUScore.calculate_bleu(pred_seq, tgt_seq)
                    cer_i = CERScore.calculate_cer(
                        [t for t in pred_seq if t > 0],
                        [t for t in tgt_seq if t > 0]
                    )
                    
                    metrics['by_lang_pair'][lang_pair]['loss'].append(loss)
                    metrics['by_lang_pair'][lang_pair]['bleu'].append(bleu_i)
                    metrics['by_lang_pair'][lang_pair]['cer'].append(cer_i)
                    metrics['by_lang_pair'][lang_pair]['token_acc'].append(token_acc)
                    metrics['by_lang_pair'][lang_pair]['seq_acc'].append(seq_acc)
                    metrics['by_lang_pair'][lang_pair]['count'] += 1
                
                # 进度显示
                if (batch_idx + 1) % 100 == 0:
                    print(f"  [{batch_idx+1}/{len(data_loader)}] Loss: {loss:.4f}, BLEU: {bleu:.4f}")
        
        # 计算平均值
        num_batches = metrics['num_batches']
        if num_batches > 0:
            metrics['avg_loss'] = metrics['total_loss'] / num_batches
            metrics['avg_bleu'] = metrics['total_bleu'] / num_batches
            metrics['avg_cer'] = metrics['total_cer'] / num_batches
            metrics['avg_token_acc'] = metrics['total_token_acc'] / num_batches
            metrics['avg_seq_acc'] = metrics['total_seq_acc'] / num_batches
            metrics['avg_ppl'] = Perplexity.calculate_ppl(metrics['avg_loss'])
        
        return metrics
    
    @staticmethod
    def print_metrics(metrics, dataset_name="Dataset"):
        """打印指标"""
        print(f"\n{'='*80}")
        print(f"📊 {dataset_name} 评估结果")
        print(f"{'='*80}")
        
        print(f"\n🎯 全局指标:")
        print(f"  Loss:           {metrics.get('avg_loss', 0):.4f}")
        print(f"  PPL:            {metrics.get('avg_ppl', 0):.2f}")
        print(f"  BLEU:           {metrics.get('avg_bleu', 0):.4f}")
        print(f"  CER:            {metrics.get('avg_cer', 0):.4f}")
        print(f"  Token Acc:      {metrics.get('avg_token_acc', 0):.4f}")
        print(f"  Sequence Acc:   {metrics.get('avg_seq_acc', 0):.4f}")
        
        # 按语言对
        if metrics['by_lang_pair']:
            print(f"\n📌 Top 10 语言对 (按 BLEU):")
            top_pairs = sorted(
                metrics['by_lang_pair'].items(),
                key=lambda x: np.mean(x[1]['bleu']) if x[1]['bleu'] else 0,
                reverse=True
            )[:10]
            
            print(f"{'Lang Pair':<12} {'BLEU':<8} {'CER':<8} {'Acc':<8} {'Samples':<8}")
            print("-" * 50)
            for lang_pair, stats in top_pairs:
                bleu = np.mean(stats['bleu']) if stats['bleu'] else 0
                cer = np.mean(stats['cer']) if stats['cer'] else 0
                acc = np.mean(stats['token_acc']) if stats['token_acc'] else 0
                count = stats['count']
                print(f"{lang_pair:<12} {bleu:<8.4f} {cer:<8.4f} {acc:<8.4f} {count:<8}")
            
            # 最差的语言对
            print(f"\n⚠️  Bottom 5 语言对 (按 BLEU):")
            bottom_pairs = sorted(
                metrics['by_lang_pair'].items(),
                key=lambda x: np.mean(x[1]['bleu']) if x[1]['bleu'] else 0
            )[:5]
            
            print(f"{'Lang Pair':<12} {'BLEU':<8} {'CER':<8} {'Acc':<8} {'Samples':<8}")
            print("-" * 50)
            for lang_pair, stats in bottom_pairs:
                bleu = np.mean(stats['bleu']) if stats['bleu'] else 0
                cer = np.mean(stats['cer']) if stats['cer'] else 0
                acc = np.mean(stats['token_acc']) if stats['token_acc'] else 0
                count = stats['count']
                print(f"{lang_pair:<12} {bleu:<8.4f} {cer:<8.4f} {acc:<8.4f} {count:<8}")
        
        print(f"{'='*80}\n")


