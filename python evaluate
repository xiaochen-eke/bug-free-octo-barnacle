def main():
    import argparse
    
    parser = argparse.ArgumentParser(description='评估验证集和测试集')
    parser.add_argument('--model-path', type=str, default='checkpoints/best_model.pth',
                        help='模型路径')
    parser.add_argument('--val-csv', type=str,
                        default=r'C:\DLdata\git\ecj\multilingual_transformer\backend\data\processed\val_with_lang.csv',
                        help='验证集CSV路径')
    parser.add_argument('--test-csv', type=str,
                        default=r'C:\DLdata\git\ecj\multilingual_transformer\backend\data\processed\test_with_lang.csv',
                        help='测试集CSV路径')
    parser.add_argument('--sp-model', type=str,
                        default=r'C:\DLdata\git\ecj\multilingual_transformer\backend\tokenizer\multilingual.model',
                        help='tokenizer模型路径')
    parser.add_argument('--batch-size', type=int, default=32)
    parser.add_argument('--max-len', type=int, default=128)
    parser.add_argument('--save-results', type=str, default='evaluation_results.json',
                        help='保存结果的JSON文件')
    
    args = parser.parse_args()
    
    DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    VOCAB_SIZE = 32000
    
    print(f"Device: {DEVICE}")
    print(f"Model: {args.model_path}")
    
    # =====================================
    # 加载模型
    # =====================================
    
    print("\n📦 加载模型...")
    model = TransformerModel(vocab_size=VOCAB_SIZE).to(DEVICE)
    
    if os.path.exists(args.model_path):
        model.load_state_dict(torch.load(args.model_path, map_location=DEVICE))
        print(f"✓ 模型已加载: {args.model_path}")
    else:
        print(f"⚠️  模型文件不存在: {args.model_path}")
        print(f"   会使用随机初始化的模型")
    
    # =====================================
    # Loss
    # =====================================
    
    criterion = nn.CrossEntropyLoss(ignore_index=0, label_smoothing=0.1)
    
    # =====================================
    # 评估器
    # =====================================
    
    evaluator = Evaluator(model, DEVICE, VOCAB_SIZE)
    
    results = {}
    
    # =====================================
    # 验证集
    # =====================================
    
    if os.path.exists(args.val_csv):
        print(f"\n{'='*80}")
        print("📊 评估验证集...")
        print(f"{'='*80}")
        
        val_dataset = TranslationDataset(
            csv_file=args.val_csv,
            sp_model_path=args.sp_model,
            max_length=args.max_len
        )
        
        val_loader = DataLoader(
            val_dataset,
            batch_size=args.batch_size,
            shuffle=False,
            num_workers=4
        )
        
        print(f"验证集大小: {len(val_dataset):,}")
        val_metrics = evaluator.evaluate(val_loader, criterion)
        Evaluator.print_metrics(val_metrics, "验证集")
        results['validation'] = {
            'avg_loss': val_metrics.get('avg_loss', 0),
            'avg_ppl': val_metrics.get('avg_ppl', 0),
            'avg_bleu': val_metrics.get('avg_bleu', 0),
            'avg_cer': val_metrics.get('avg_cer', 0),
            'avg_token_acc': val_metrics.get('avg_token_acc', 0),
            'avg_seq_acc': val_metrics.get('avg_seq_acc', 0),
        }
    else:
        print(f"⚠️  验证集不存在: {args.val_csv}")
    
    # =====================================
    # 测试集
    # =====================================
    
    if os.path.exists(args.test_csv):
        print(f"\n{'='*80}")
        print("📊 评估测试集...")
        print(f"{'='*80}")
        
        test_dataset = TranslationDataset(
            csv_file=args.test_csv,
            sp_model_path=args.sp_model,
            max_length=args.max_len
        )
        
        test_loader = DataLoader(
            test_dataset,
            batch_size=args.batch_size,
            shuffle=False,
            num_workers=4
        )
        
        print(f"测试集大小: {len(test_dataset):,}")
        test_metrics = evaluator.evaluate(test_loader, criterion)
        Evaluator.print_metrics(test_metrics, "测试集")
        results['test'] = {
            'avg_loss': test_metrics.get('avg_loss', 0),
            'avg_ppl': test_metrics.get('avg_ppl', 0),
            'avg_bleu': test_metrics.get('avg_bleu', 0),
            'avg_cer': test_metrics.get('avg_cer', 0),
            'avg_token_acc': test_metrics.get('avg_token_acc', 0),
            'avg_seq_acc': test_metrics.get('avg_seq_acc', 0),
        }
    else:
        print(f"⚠️  测试集不存在: {args.test_csv}")
    
    # =====================================
    # 保存结果
    # =====================================
    
    if results:
        with open(args.save_results, 'w') as f:
            json.dump(results, f, indent=2)
        print(f"\n💾 结果已保存: {args.save_results}")
    
    # =====================================
    # 总结
    # =====================================
    
    print(f"\n{'='*80}")
    print("📈 评估总结")
    print(f"{'='*80}")
    
    if 'validation' in results:
        val = results['validation']
        print(f"\n验证集:")
        print(f"  BLEU: {val['avg_bleu']:.4f}")
        print(f"  Acc:  {val['avg_token_acc']:.4f}")
        print(f"  PPL:  {val['avg_ppl']:.2f}")
    
    if 'test' in results:
        test = results['test']
        print(f"\n测试集:")
        print(f"  BLEU: {test['avg_bleu']:.4f}")
        print(f"  Acc:  {test['avg_token_acc']:.4f}")
        print(f"  PPL:  {test['avg_ppl']:.2f}")
    
    print(f"\n{'='*80}")


if __name__ == "__main__":
    main()