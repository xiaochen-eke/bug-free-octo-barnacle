class TranslationDataset:
    """翻译数据集"""
    
    def __init__(self, 
                 src_texts: List[str],
                 tgt_texts: List[str],
                 src_vocab: Vocabulary,
                 tgt_vocab: Vocabulary,
                 src_lang: str,
                 tgt_lang: str,
                 max_seq_len: int = 128):
        
        self.src_vocab = src_vocab
        self.tgt_vocab = tgt_vocab
        self.max_seq_len = max_seq_len
        
        # 预处理
        preprocessor = TextPreprocessor()
        tokenizer = MultilingualTokenizer()
        
        self.src_samples = []
        self.tgt_samples = []
        
        for src_text, tgt_text in zip(src_texts, tgt_texts):
            # 清洗
            src_text = preprocessor.clean_text(src_text)
            tgt_text = preprocessor.clean_text(tgt_text)
            
            # 分词
            src_tokens = tokenizer.tokenize(src_text, src_lang)
            tgt_tokens = tokenizer.tokenize(tgt_text, tgt_lang)
            
            # 长度过滤
            if len(src_tokens) > max_seq_len or len(tgt_tokens) > max_seq_len:
                continue
            
            # 编码
            src_indices = src_vocab.encode(src_tokens)
            tgt_indices = tgt_vocab.encode(tgt_tokens)
            
            self.src_samples.append(src_indices)
            self.tgt_samples.append(tgt_indices)
    
    def __len__(self):
        return len(self.src_samples)
    
    def __getitem__(self, idx):
        return {
            'src': np.array(self.src_samples[idx]),
            'tgt': np.array(self.tgt_samples[idx])
        }


class DataCollator:
    """数据批处理器"""
    
    def __init__(self, src_vocab: Vocabulary, tgt_vocab: Vocabulary, max_seq_len: int = 128):
        self.src_vocab = src_vocab
        self.tgt_vocab = tgt_vocab
        self.max_seq_len = max_seq_len
        self.pad_idx = src_vocab.word2idx[Vocabulary.PAD_TOKEN]
    
    def __call__(self, batch: List[Dict]):
        """批处理"""
        src_seqs = [item['src'] for item in batch]
        tgt_seqs = [item['tgt'] for item in batch]
        
        # 填充
        src_padded = self._pad_sequences(src_seqs, self.src_vocab)
        tgt_padded = self._pad_sequences(tgt_seqs, self.tgt_vocab)
        
        # 创建注意力掩码
        src_mask = (src_padded != self.pad_idx).astype(np.float32)
        tgt_mask = (tgt_padded != self.tgt_vocab.word2idx[Vocabulary.PAD_TOKEN]).astype(np.float32)
        
        return {
            'src': src_padded,
            'tgt': tgt_padded,
            'src_mask': src_mask,
            'tgt_mask': tgt_mask
        }
    
    def _pad_sequences(self, sequences: List[np.ndarray], vocab: Vocabulary) -> np.ndarray:
        """填充序列到最大长度"""
        pad_idx = vocab.word2idx[Vocabulary.PAD_TOKEN]
        padded = np.full((len(sequences), self.max_seq_len), pad_idx, dtype=np.int64)
        
        for i, seq in enumerate(sequences):
            length = min(len(seq), self.max_seq_len)
            padded[i, :length] = seq[:length]
        
        return padded


