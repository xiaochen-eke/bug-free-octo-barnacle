class OpusDatasetProcessor:
    """Opus-100数据集处理器"""
    
    LANGUAGE_PAIRS = [
        ('zh', 'en'), ('zh', 'ja'), ('zh', 'fr'), ('zh', 'de'),
        ('en', 'zh'), ('en', 'ja'), ('en', 'fr'), ('en', 'de'),
        ('ja', 'zh'), ('ja', 'en'), ('ja', 'fr'), ('ja', 'de'),
        ('fr', 'zh'), ('fr', 'en'), ('fr', 'ja'), ('fr', 'de'),
        ('de', 'zh'), ('de', 'en'), ('de', 'ja'), ('de', 'fr'),
    ]
    
    def __init__(self, dataset_dir: str = './data', min_freq: int = 2):
        self.dataset_dir = Path(dataset_dir)
        self.dataset_dir.mkdir(parents=True, exist_ok=True)
        self.min_freq = min_freq
        
        self.preprocessor = TextPreprocessor()
        self.tokenizer = MultilingualTokenizer()
        self.vocabularies = {}  # {language: Vocabulary}
    
    def load_corpus(self, lang_pair: Tuple[str, str], max_samples: int = None) -> Tuple[List[str], List[str]]:
        """
        加载平行语料
        
        由于直接从Opus-100获取数据较复杂，这里演示如何处理已有的平行文本文件
        实际使用时可从以下来源加载：
        - https://object.pouta.csc.fi/OPUS-100/
        - Hugging Face datasets (opus_books, opus_euparl等)
        """
        src_lang, tgt_lang = lang_pair
        src_file = self.dataset_dir / f'train.{src_lang}'
        tgt_file = self.dataset_dir / f'train.{tgt_lang}'
        
        src_texts, tgt_texts = [], []
        
        if src_file.exists() and tgt_file.exists():
            with open(src_file, 'r', encoding='utf-8') as f:
                src_texts = [line.strip() for line in f if line.strip()]
            
            with open(tgt_file, 'r', encoding='utf-8') as f:
                tgt_texts = [line.strip() for line in f if line.strip()]
            
            # 确保长度相等
            min_len = min(len(src_texts), len(tgt_texts))
            src_texts = src_texts[:min_len]
            tgt_texts = tgt_texts[:min_len]
            
            if max_samples:
                src_texts = src_texts[:max_samples]
                tgt_texts = tgt_texts[:max_samples]
        
        return src_texts, tgt_texts
    
    def preprocess_and_tokenize(self, texts: List[str], language: str) -> List[List[str]]:
        """预处理和分词"""
        processed = []
        for text in texts:
            # 清洗
            text = self.preprocessor.clean_text(text)
            # 移除URL和邮箱
            text = self.preprocessor.remove_urls(text)
            text = self.preprocessor.remove_emails(text)
            # 分词
            tokens = self.tokenizer.tokenize(text, language)
            processed.append(tokens)
        
        return processed
    
    def build_vocabularies(self, lang_pair: Tuple[str, str], max_samples: int = None):
        """为语言对构建词汇表"""
        src_lang, tgt_lang = lang_pair
        
        logger.info(f"Loading corpus for {src_lang}-{tgt_lang}...")
        src_texts, tgt_texts = self.load_corpus(lang_pair, max_samples)
        
        logger.info(f"Preprocessing and tokenizing {src_lang}...")
        src_tokens = self.preprocess_and_tokenize(src_texts, src_lang)
        
        logger.info(f"Preprocessing and tokenizing {tgt_lang}...")
        tgt_tokens = self.preprocess_and_tokenize(tgt_texts, tgt_lang)
        
        # 构建词汇表
        if src_lang not in self.vocabularies:
            logger.info(f"Building vocabulary for {src_lang}...")
            src_vocab = Vocabulary(min_freq=self.min_freq)
            src_vocab.build_vocab(src_tokens)
            self.vocabularies[src_lang] = src_vocab
        
        if tgt_lang not in self.vocabularies:
            logger.info(f"Building vocabulary for {tgt_lang}...")
            tgt_vocab = Vocabulary(min_freq=self.min_freq)
            tgt_vocab.build_vocab(tgt_tokens)
            self.vocabularies[tgt_lang] = tgt_vocab
        
        return src_tokens, tgt_tokens
    
    def save_vocabularies(self, vocab_dir: str = './vocab'):
        """保存所有词汇表"""
        vocab_path = Path(vocab_dir)
        vocab_path.mkdir(parents=True, exist_ok=True)
        
        for lang, vocab in self.vocabularies.items():
            filepath = vocab_path / f'vocab_{lang}.pkl'
            vocab.save(str(filepath))
            logger.info(f"Saved vocabulary for {lang} to {filepath}")
    
    def load_vocabularies(self, vocab_dir: str = './vocab'):
        """加载所有词汇表"""
        vocab_path = Path(vocab_dir)
        
        for lang_file in vocab_path.glob('vocab_*.pkl'):
            lang = lang_file.stem.replace('vocab_', '')
            vocab = Vocabulary()
            vocab.load(str(lang_file))
            self.vocabularies[lang] = vocab
            logger.info(f"Loaded vocabulary for {lang} from {lang_file}")


