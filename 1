# ============================================================================
# 多语言分词器
# ============================================================================

class MultilingualTokenizer:
    """支持中文、日文、英文、法文、德文的多语言分词器"""
    
    def __init__(self):
        self.zh_stopwords = self._load_zh_stopwords()
        self.en_stopwords = self._load_en_stopwords()
    
    @staticmethod
    def _load_zh_stopwords():
        """加载中文停用词"""
        stopwords = {
            '的', '一', '是', '在', '不', '了', '有', '和', '人', '这',
            '中', '大', '为', '上', '个', '国', '我', '以', '要', '他',
            '时', '来', '用', '们', '生', '到', '作', '地', '于', '出',
            '就', '分', '对', '成', '会', '可', '主', '发', '年', '动'
        }
        return stopwords
    
    @staticmethod
    def _load_en_stopwords():
        """加载英文停用词"""
        stopwords = {
            'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to',
            'for', 'of', 'with', 'by', 'from', 'as', 'is', 'was', 'are',
            'be', 'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would',
            'should', 'could', 'may', 'might', 'must', 'can', 'this', 'that',
            'these', 'those', 'i', 'you', 'he', 'she', 'it', 'we', 'they'
        }
        return stopwords
    
    def tokenize_chinese(self, text: str) -> List[str]:
        """中文分词"""
        # 使用jieba进行中文分词
        tokens = jieba.cut(text.strip(), cut_all=False)
        # 过滤停用词和纯空格
        tokens = [t for t in tokens if t.strip() and t not in self.zh_stopwords]
        return tokens
    
    def tokenize_english(self, text: str) -> List[str]:
        """英文分词"""
        # 转换为小写
        text = text.lower()
        # 分词
        tokens = re.findall(r'\b\w+\b', text)
        # 过滤停用词
        tokens = [t for t in tokens if t not in self.en_stopwords]
        return tokens
    
    def tokenize_japanese(self, text: str) -> List[str]:
        """日文分词"""
        try:
            import fugashi
            tagger = fugashi.Tagger()
            words = tagger(text)
            tokens = [word.surface for word in words if word.surface.strip()]
            return tokens
        except ImportError:
            logger.warning("fugashi not installed, using simple character-level tokenization for Japanese")
            return list(text.strip())
    
    def tokenize_french(self, text: str) -> List[str]:
        """法文分词"""
        text = text.lower()
        # 简单的空格和标点符号分词
        tokens = re.findall(r'\b\w+\b', text)
        return tokens
    
    def tokenize_german(self, text: str) -> List[str]:
        """德文分词"""
        text = text.lower()
        # 简单的空格和标点符号分词
        tokens = re.findall(r'\b\w+\b', text)
        return tokens
    
    def tokenize(self, text: str, language: str) -> List[str]:
        """通用分词接口"""
        if language == 'zh':
            return list(self.tokenize_chinese(text))
        elif language == 'en':
            return self.tokenize_english(text)
        elif language == 'ja':
            return self.tokenize_japanese(text)
        elif language == 'fr':
            return self.tokenize_french(text)
        elif language == 'de':
            return self.tokenize_german(text)
        else:
            raise ValueError(f"Unsupported language: {language}")


# ============================================================================
# 文本预处理
# ============================================================================

class TextPreprocessor:
    """文本规范化和清洗"""
    
    @staticmethod
    def normalize_unicode(text: str) -> str:
        """Unicode规范化"""
        return unicodedata.normalize('NFKC', text)
    
    @staticmethod
    def remove_control_chars(text: str) -> str:
        """移除控制字符"""
        return ''.join(ch for ch in text if unicodedata.category(ch)[0] != 'C')
    
    @staticmethod
    def remove_extra_whitespace(text: str) -> str:
        """移除多余空白"""
        text = re.sub(r'\s+', ' ', text)
        return text.strip()
    
    @staticmethod
    def clean_text(text: str) -> str:
        """综合文本清洗"""
        # Unicode规范化
        text = TextPreprocessor.normalize_unicode(text)
        # 移除控制字符
        text = TextPreprocessor.remove_control_chars(text)
        # 移除多余空白
        text = TextPreprocessor.remove_extra_whitespace(text)
        return text
    
    @staticmethod
    def remove_urls(text: str) -> str:
        """移除URL"""
        text = re.sub(r'http[s]?://(?:[a-zA-Z]|[0-9]|[$-_@.&+]|[!*\\(\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+', '', text)
        return text
    
    @staticmethod
    def remove_emails(text: str) -> str:
        """移除邮箱"""
        text = re.sub(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b', '', text)
        return text
    
    @staticmethod
    def remove_special_chars(text: str) -> str:
        """移除特殊字符（保留基本标点）"""
        text = re.sub(r'[^\w\s\u4e00-\u9fff\u3040-\u309f\u3400-\u4dbfぁ-ゞァ-ヴー一-龠々〆〤\u00c0-\u024f]', ' ', text)
        return text


# ============================================================================
# 词汇表构建
# ============================================================================

class Vocabulary:
    """词汇表管理"""
    
    # 特殊标记
    PAD_TOKEN = '<pad>'
    BOS_TOKEN = '<bos>'
    EOS_TOKEN = '<eos>'
    UNK_TOKEN = '<unk>'
    
    def __init__(self, min_freq: int = 2):
        self.min_freq = min_freq
        self.word2idx = {}
        self.idx2word = {}
        self.word_freq = Counter()
        self._init_special_tokens()
    
    def _init_special_tokens(self):
        """初始化特殊标记"""
        special_tokens = [
            self.PAD_TOKEN,
            self.BOS_TOKEN,
            self.EOS_TOKEN,
            self.UNK_TOKEN
        ]
        for token in special_tokens:
            idx = len(self.word2idx)
            self.word2idx[token] = idx
            self.idx2word[idx] = token
    
    def build_vocab(self, tokens_list: List[List[str]]):
        """从令牌列表构建词汇表"""
        # 统计词频
        for tokens in tokens_list:
            self.word_freq.update(tokens)
        
        # 添加高频词汇
        for word, freq in self.word_freq.items():
            if freq >= self.min_freq:
                idx = len(self.word2idx)
                self.word2idx[word] = idx
                self.idx2word[idx] = word
    
    def encode(self, tokens: List[str]) -> List[int]:
        """将令牌编码为索引"""
        return [
            self.word2idx.get(token, self.word2idx[self.UNK_TOKEN])
            for token in tokens
        ]
    
    def decode(self, indices: List[int]) -> List[str]:
        """将索引解码为令牌"""
        return [self.idx2word.get(idx, self.UNK_TOKEN) for idx in indices]
    
    def __len__(self):
        return len(self.word2idx)
    
    def save(self, filepath: str):
        """保存词汇表"""
        with open(filepath, 'wb') as f:
            pickle.dump({
                'word2idx': self.word2idx,
                'idx2word': self.idx2word,
                'word_freq': self.word_freq,
                'min_freq': self.min_freq
            }, f)
    
    def load(self, filepath: str):
        """加载词汇表"""
        with open(filepath, 'rb') as f:
            data = pickle.load(f)
            self.word2idx = data['word2idx']
            self.idx2word = data['idx2word']
            self.word_freq = data['word_freq']
            self.min_freq = data['min_freq']


