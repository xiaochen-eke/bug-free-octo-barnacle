# ============================================================================
# 模型加载和推理
# ============================================================================

class MBartTranslationEngine:
    """mBart-50翻译引擎"""
    
    def __init__(self, 
                 checkpoint_dir: str = "./backend/checkpoints/mbart50_lora_8_directions_clean",
                 device: str = 'cuda' if torch.cuda.is_available() else 'cpu'):
        """
        初始化翻译引擎
        
        Args:
            checkpoint_dir: 检查点目录（包含adapter_config.json）
            device: 计算设备
        """
        self.checkpoint_dir = Path(checkpoint_dir)
        self.device = device
        self.model = None
        self.tokenizer = None
        
        logger.info(f"Initializing MBart translation engine with device: {device}")
        self._load_model()
    
    def _load_model(self):
        """加载mBart-50 + LoRA适配器"""
        try:
            # 加载基础模型名称
            model_name = "facebook/mbart-large-50-many-to-many-mmt"
            
            logger.info(f"Loading tokenizer from {model_name}...")
            self.tokenizer = AutoTokenizer.from_pretrained(
                model_name,
                use_auth_token=None,
                trust_remote_code=True
            )
            
            # 检查是否有LoRA适配器
            adapter_config_path = self.checkpoint_dir / "adapter_config.json"
            
            if adapter_config_path.exists():
                logger.info(f"Loading LoRA adapter from {self.checkpoint_dir}...")
                try:
                    # 加载带有LoRA适配器的模型
                    self.model = AutoPeftModelForSeq2SeqLM.from_pretrained(
                        str(self.checkpoint_dir),
                        device_map=self.device if self.device == 'cuda' else None,
                        torch_dtype=torch.float16 if self.device == 'cuda' else torch.float32,
                        load_in_4bit=False
                    )
                    
                    # 合并LoRA权重到基础模型（可选，会减少内存使用）
                    # self.model = self.model.merge_and_unload()
                    
                    logger.info("LoRA adapter loaded successfully")
                except Exception as e:
                    logger.warning(f"Failed to load LoRA adapter: {e}")
                    logger.info("Falling back to base model...")
                    self.model = AutoModelForSeq2SeqLM.from_pretrained(
                        model_name,
                        device_map=self.device if self.device == 'cuda' else None,
                        torch_dtype=torch.float16 if self.device == 'cuda' else torch.float32,
                    )
            else:
                logger.info("No LoRA adapter found, loading base model...")
                self.model = AutoModelForSeq2SeqLM.from_pretrained(
                    model_name,
                    device_map=self.device if self.device == 'cuda' else None,
                    torch_dtype=torch.float16 if self.device == 'cuda' else torch.float32,
                )
            
            self.model.eval()
            
            total_params = sum(p.numel() for p in self.model.parameters())
            logger.info(f"Model loaded successfully. Total parameters: {total_params:,}")
            
        except Exception as e:
            logger.error(f"Failed to load model: {e}")
            raise
    
    def translate(self, 
                  text: str,
                  src_lang: str,
                  tgt_lang: str,
                  max_length: int = 256) -> str:
        """
        翻译文本
        
        Args:
            text: 源文本
            src_lang: 源语言代码 (e.g., 'en')
            tgt_lang: 目标语言代码 (e.g., 'zh')
            max_length: 最大生成长度
        
        Returns:
            翻译文本
        """
        if not text.strip():
            return ""
        
        try:
            # 获取mBart语言代码
            src_mbart_lang = MBART_LANGUAGE_CODE.get(src_lang, 'en_XX')
            tgt_mbart_lang = MBART_LANGUAGE_CODE.get(tgt_lang, 'zh_CN')
            
            # 编码
            inputs = self.tokenizer(
                text,
                return_tensors="pt",
                max_length=512,
                truncation=True,
                padding=True
            )
            
            # 移到设备
            if self.device == 'cuda':
                inputs = {k: v.to(self.device) for k, v in inputs.items()}
            
            # 设置源语言
            inputs["decoder_input_ids"] = self.tokenizer.convert_tokens_to_ids(
                [tgt_mbart_lang]
            ) * torch.ones(inputs['input_ids'].shape[0], 1, dtype=torch.long)
            
            if self.device == 'cuda':
                inputs["decoder_input_ids"] = inputs["decoder_input_ids"].to(self.device)
            
            # 生成翻译
            with torch.no_grad():
                generated_ids = self.model.generate(
                    **inputs,
                    max_length=max_length,
                    num_beams=5,
                    early_stopping=True,
                    forced_bos_token_id=self.tokenizer.convert_tokens_to_ids(tgt_mbart_lang)
                )
            
            # 解码
            translation = self.tokenizer.decode(
                generated_ids[0],
                skip_special_tokens=True
            )
            
            return translation.strip()
        
        except Exception as e:
            logger.error(f"Translation error: {e}")
            raise
    
    def translate_batch(self, 
                       texts: List[str],
                       src_lang: str,
                       tgt_lang: str,
                       max_length: int = 256) -> List[str]:
        """批量翻译"""
        return [self.translate(text, src_lang, tgt_lang, max_length) for text in texts]


# ============================================================================
# 全局翻译引擎
# ============================================================================

translation_engine = None
initialized_time = None

def get_translation_engine():
    """获取翻译引擎单例"""
    global translation_engine
    if translation_engine is None:
        translation_engine = MBartTranslationEngine()
    return translation_engine

