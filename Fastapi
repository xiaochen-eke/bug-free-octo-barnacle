@app.get("/health")
async def health_check():
    """健康检查"""
    return {
        "status": "ok",
        "device": torch.device('cuda' if torch.cuda.is_available() else 'cpu').type,
        "model": "mBart-50-LoRA-8-Directions",
        "supported_language_pairs": len(SUPPORTED_LANGUAGE_PAIRS),
        "gpu_available": torch.cuda.is_available(),
        "initialized_time": initialized_time
    }

@app.get("/languages")
async def get_languages():
    """获取支持的语言列表"""
    languages = {}
    for code, name in LANGUAGE_NAMES.items():
        if code in [lang for pair in SUPPORTED_LANGUAGE_PAIRS for lang in pair]:
            languages[code] = name
    
    supported_pairs = [
        {"source": src, "target": tgt}
        for src, tgt in SUPPORTED_LANGUAGE_PAIRS
    ]
    
    return {
        "languages": languages,
        "supported_pairs": supported_pairs
    }

@app.get("/language-pairs")
async def get_language_pairs():
    """获取支持的语言对"""
    return {
        "language_pairs": [
            {
                "source": src,
                "source_name": LANGUAGE_NAMES.get(src, src),
                "target": tgt,
                "target_name": LANGUAGE_NAMES.get(tgt, tgt)
            }
            for src, tgt in SUPPORTED_LANGUAGE_PAIRS
        ]
    }

@app.get("/model-info")
async def get_model_info():
    """获取模型信息"""
    engine = get_translation_engine()
    total_params = sum(p.numel() for p in engine.model.parameters())
    
    return {
        "model_name": "mBart-50-many-to-many-mmt + LoRA",
        "model_type": "Sequence-to-Sequence",
        "parameters": total_params,
        "max_sequence_length": 1024,
        "training_status": "Fine-tuned with LoRA on 8 translation directions",
        "bleu_score": 27.48,
        "supported_languages": len(set(lang for pair in SUPPORTED_LANGUAGE_PAIRS for lang in pair)),
        "supported_language_pairs": len(SUPPORTED_LANGUAGE_PAIRS)
    }

@app.post("/translate", response_model=TranslationResponse)
async def translate(request: TranslationRequest):
    """翻译单个文本"""
    
    # 验证语言对
    if (request.source_language, request.target_language) not in SUPPORTED_LANGUAGE_PAIRS:
        raise HTTPException(
            status_code=400,
            detail=f"Language pair {request.source_language}-{request.target_language} not supported"
        )
    
    try:
        start_time = datetime.now()
        
        # 获取翻译引擎
        engine = get_translation_engine()
        
        # 翻译
        translated_text = engine.translate(
            request.text,
            request.source_language,
            request.target_language,
            request.max_length
        )
        
        processing_time = (datetime.now() - start_time).total_seconds()
        
        return {
            "original_text": request.text,
            "translated_text": translated_text,
            "source_language": request.source_language,
            "target_language": request.target_language,
            "model": "mBart-50-LoRA",
            "bleu_score": 27.48,
            "confidence": 0.95,
            "processing_time": processing_time
        }
    
    except Exception as e:
        logger.error(f"Translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/translate-batch")
async def translate_batch(request: BatchTranslationRequest):
    """批量翻译"""
    
    # 验证语言对
    if (request.source_language, request.target_language) not in SUPPORTED_LANGUAGE_PAIRS:
        raise HTTPException(
            status_code=400,
            detail=f"Language pair {request.source_language}-{request.target_language} not supported"
        )
    
    try:
        engine = get_translation_engine()
        
        results = []
        for text in request.texts:
            translated = engine.translate(
                text,
                request.source_language,
                request.target_language
            )
            results.append({
                "original": text,
                "translated": translated
            })
        
        return {"results": results}
    
    except Exception as e:
        logger.error(f"Batch translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/translate-file")
async def translate_file(
    file: UploadFile = File(...),
    source_language: str = "en",
    target_language: str = "zh"
):
    """翻译上传的文件"""
    
    # 验证语言对
    if (source_language, target_language) not in SUPPORTED_LANGUAGE_PAIRS:
        raise HTTPException(
            status_code=400,
            detail=f"Language pair {source_language}-{target_language} not supported"
        )
    
    try:
        # 读取文件
        content = await file.read()
        text = content.decode('utf-8')
        
        # 按行分割
        lines = text.strip().split('\n')
        
        # 翻译
        engine = get_translation_engine()
        translated_lines = []
        
        for line in lines:
            if line.strip():
                try:
                    translated = engine.translate(line, source_language, target_language)
                    translated_lines.append(translated)
                except Exception as e:
                    logger.error(f"Error translating line: {e}")
                    translated_lines.append(f"[ERROR] {str(e)}")
            else:
                translated_lines.append("")
        
        translated_content = '\n'.join(translated_lines)
        
        return {
            "original_filename": file.filename,
            "translated_content": translated_content,
            "source_language": source_language,
            "target_language": target_language,
            "lines_translated": len([l for l in lines if l.strip()])
        }
    
    except Exception as e:
        logger.error(f"File translation error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

