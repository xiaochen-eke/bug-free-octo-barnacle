class WarmupScheduler:
    """
    学习率预热调度器
    
    在初始阶段线性增加学习率，之后按照固定比例衰减
    """
    
    def __init__(self, optimizer: optim.Optimizer, d_model: int, warmup_steps: int, factor: float = 1.0):
        """
        Args:
            optimizer: PyTorch优化器
            d_model: 模型维度
            warmup_steps: 预热步数
            factor: 缩放因子
        """
        self.optimizer = optimizer
        self.d_model = d_model
        self.warmup_steps = warmup_steps
        self.factor = factor
        self.step_count = 0
    
    def step(self):
        """更新学习率"""
        self.step_count += 1
        
        # 计算学习率
        if self.step_count <= self.warmup_steps:
            # 预热阶段：线性增加
            lr = self.factor * (self.d_model ** (-0.5)) * \
                 min(self.step_count ** (-0.5), self.step_count * self.warmup_steps ** (-1.5))
        else:
            # 衰减阶段：按step_count^(-0.5)衰减
            lr = self.factor * (self.d_model ** (-0.5)) * (self.step_count ** (-0.5))
        
        # 应用到所有参数组
        for param_group in self.optimizer.param_groups:
            param_group['lr'] = lr
        
        return lr


class Trainer:
    """
    机器翻译模型训练器
    """
    
    def __init__(self, config_dict: dict, device: str = 'cuda'):
        """
        Args:
            config_dict: 配置字典
            device: 计算设备
        """
        self.config = config_dict
        self.device = torch.device(device if torch.cuda.is_available() else 'cpu')
        
        # 设置随机种子
        set_seed(self.config['training']['seed'])
        
        # 创建目录
        create_directories(self.config)
        
        # 初始化TensorBoard
        log_dir = self.config['logging']['tensorboard_dir']
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        self.writer = SummaryWriter(os.path.join(log_dir, timestamp))
        
        # 初始化数据
        logger.info("初始化数据...")
        self.data_pipeline = DataPipeline(self.config)
        self.train_loader, self.valid_loader, self.test_loader = \
            self.data_pipeline.run()
        
        # 初始化模型
        logger.info("初始化模型...")
        self.model = TransformerMT(
            src_vocab_size=len(self.data_pipeline.src_vocab),
            tgt_vocab_size=len(self.data_pipeline.tgt_vocab),
            d_model=self.config['model']['d_model'],
            nhead=self.config['model']['nhead'],
            d_ff=self.config['model']['d_ff'],
            num_encoder_layers=self.config['model']['num_encoder_layers'],
            num_decoder_layers=self.config['model']['num_decoder_layers'],
            max_seq_length=self.config['model']['max_seq_length'],
            dropout=self.config['model']['dropout'],
            pad_idx=self.data_pipeline.src_vocab.pad_idx
        ).to(self.device)
        
        logger.info(f"模型参数数量: {sum(p.numel() for p in self.model.parameters()):,}")
        
        # 初始化优化器
        self.optimizer = optim.Adam(
            self.model.parameters(),
            lr=self.config['training']['learning_rate'],
            betas=(self.config['training']['beta1'], self.config['training']['beta2']),
            eps=self.config['training']['eps'],
            weight_decay=self.config['training']['weight_decay']
        )
        
        # 学习率调度器
        self.scheduler = WarmupScheduler(
            self.optimizer,
            self.config['model']['d_model'],
            self.config['model']['warmup_steps'],
            self.config['model']['factor']
        )
        
        # 损失函数（忽略padding索引）
        self.criterion = nn.CrossEntropyLoss(
            ignore_index=self.data_pipeline.src_vocab.pad_idx,
            reduction='mean'
        )
        
        # 指标跟踪器
        self.metrics = MetricsTracker()
        
        # 检查点
        self.best_bleu = 0.0
        self.best_loss = float('inf')
        self.patience_counter = 0
        self.global_step = 0
    
    def train_epoch(self) -> Dict[str, float]:
        """
        训练一个epoch
        
        Returns:
            包含训练指标的字典
        """
        self.model.train()
        self.metrics.reset()
        
        progress_bar = tqdm(self.train_loader, desc="Training")
        
        for batch_idx, batch in enumerate(progress_bar):
            # 移至设备
            src_tokens = batch['src_tokens'].to(self.device)
            tgt_tokens = batch['tgt_tokens'].to(self.device)
            
            # 分离输入和目标
            tgt_input = tgt_tokens[:, :-1]  # 去掉最后一个token
            tgt_output = tgt_tokens[:, 1:]  # 去掉第一个token
            
            # 前向传播
            logits = self.model(src_tokens, tgt_input)
            
            # 计算损失
            loss = self.criterion(
                logits.reshape(-1, logits.size(-1)),
                tgt_output.reshape(-1)
            )
            
            # 梯度裁剪
            if self.config['training']['gradient_accumulation_steps'] > 1:
                loss = loss / self.config['training']['gradient_accumulation_steps']
            
            # 反向传播
            loss.backward()
            
            # 梯度累积
            if (batch_idx + 1) % self.config['training']['gradient_accumulation_steps'] == 0:
                torch.nn.utils.clip_grad_norm_(
                    self.model.parameters(),
                    self.config['training']['gradient_clip_val']
                )
                
                self.optimizer.step()
                self.optimizer.zero_grad()
                
                # 更新学习率
                self.scheduler.step()
                self.global_step += 1
            
            # 记录指标
            self.metrics.update('train_loss', loss.item() * 
                              self.config['training']['gradient_accumulation_steps'])
            
            # 更新进度条
            if batch_idx % self.config['training']['log_interval'] == 0:
                lr = self.optimizer.param_groups[0]['lr']
                avg_loss = self.metrics.get_average('train_loss')
                progress_bar.set_postfix({
                    'loss': f'{avg_loss:.4f}',
                    'lr': f'{lr:.2e}'
                })
                
                # TensorBoard记录
                self.writer.add_scalar('train/loss', avg_loss, self.global_step)
                self.writer.add_scalar('train/lr', lr, self.global_step)
        
        return self.metrics.to_dict()
    
    def validate(self) -> Dict[str, float]:
        """
        验证模型
        
        Returns:
            包含验证指标的字典
        """
        self.model.eval()
        self.metrics.reset()
        
        with torch.no_grad():
            for batch in tqdm(self.valid_loader, desc="Validating"):
                # 移至设备
                src_tokens = batch['src_tokens'].to(self.device)
                tgt_tokens = batch['tgt_tokens'].to(self.device)
                
                # 分离输入和目标
                tgt_input = tgt_tokens[:, :-1]
                tgt_output = tgt_tokens[:, 1:]
                
                # 前向传播
                logits = self.model(src_tokens, tgt_input)
                
                # 计算损失
                loss = self.criterion(
                    logits.reshape(-1, logits.size(-1)),
                    tgt_output.reshape(-1)
                )
                
                self.metrics.update('valid_loss', loss.item())
                
                # 计算BLEU（可选，较慢）
                # 这里为了效率，我们只在测试集上计算BLEU
        
        return self.metrics.to_dict()
    
    def test(self) -> Dict[str, float]:
        """
        在测试集上评估模型
        
        Returns:
            包含测试指标的字典
        """
        logger.info("在测试集上评估...")
        
        self.model.eval()
        self.metrics.reset()
        
        tgt_vocab = self.data_pipeline.tgt_vocab
        
        all_references = []
        all_hypotheses = []
        
        with torch.no_grad():
            for batch in tqdm(self.test_loader, desc="Testing"):
                # 移至设备
                src_tokens = batch['src_tokens'].to(self.device)
                tgt_tokens = batch['tgt_tokens'].to(self.device)
                
                # 分离输入和目标
                tgt_input = tgt_tokens[:, :-1]
                tgt_output = tgt_tokens[:, 1:]
                
                # 前向传播
                logits = self.model(src_tokens, tgt_input)
                
                # 计算损失
                loss = self.criterion(
                    logits.reshape(-1, logits.size(-1)),
                    tgt_output.reshape(-1)
                )
                self.metrics.update('test_loss', loss.item())
                
                # 获取预测
                predictions = torch.argmax(logits, dim=-1)
                
                # 解码
                for pred, ref in zip(predictions, tgt_output):
                    # 移除padding和特殊token
                    pred_tokens = [tgt_vocab.idx2word.get(idx.item(), '<unk>') 
                                  for idx in pred if idx.item() != tgt_vocab.pad_idx]
                    ref_tokens = [tgt_vocab.idx2word.get(idx.item(), '<unk>') 
                                 for idx in ref if idx.item() != tgt_vocab.pad_idx]
                    
                    all_references.append(ref_tokens)
                    all_hypotheses.append(pred_tokens)
        
        # 计算BLEU
        bleu_scores = BleuScore.compute_corpus_bleu(all_references, all_hypotheses)
        self.metrics.metrics.update(bleu_scores)
        
        return self.metrics.to_dict()
    
    def save_checkpoint(self, epoch: int, is_best: bool = False):
        """保存检查点"""
        checkpoint_dir = './models'
        os.makedirs(checkpoint_dir, exist_ok=True)
        
        checkpoint = {
            'epoch': epoch,
            'model_state_dict': self.model.state_dict(),
            'optimizer_state_dict': self.optimizer.state_dict(),
            'config': self.config,
            'src_vocab': self.data_pipeline.src_vocab,
            'tgt_vocab': self.data_pipeline.tgt_vocab,
        }
        
        if is_best:
            path = os.path.join(checkpoint_dir, 'best_model.pt')
        else:
            path = os.path.join(checkpoint_dir, f'checkpoint_epoch_{epoch}.pt')
        
        torch.save(checkpoint, path)
        logger.info(f"保存检查点到 {path}")
    
    def load_checkpoint(self, path: str):
        """加载检查点"""
        checkpoint = torch.load(path, map_location=self.device)
        
        self.model.load_state_dict(checkpoint['model_state_dict'])
        self.optimizer.load_state_dict(checkpoint['optimizer_state_dict'])
        
        logger.info(f"从 {path} 加载检查点")
        return checkpoint['epoch']
    
    def train(self, num_epochs: int):
        """
        完整的训练循环
        
        Args:
            num_epochs: 训练epoch数
        """
        logger.info("=" * 60)
        logger.info("开始训练")
        logger.info("=" * 60)
        
        for epoch in range(num_epochs):
            logger.info(f"\nEpoch {epoch + 1}/{num_epochs}")
            
            # 训练
            train_metrics = self.train_epoch()
            logger.info(f"Train - Loss: {train_metrics['train_loss']:.4f}")
            
            # 验证
            if (epoch + 1) % self.config['training']['valid_interval'] == 0 or epoch == 0:
                valid_metrics = self.validate()
                logger.info(f"Valid - Loss: {valid_metrics['valid_loss']:.4f}")
                
                # TensorBoard记录
                self.writer.add_scalar('valid/loss', valid_metrics['valid_loss'], epoch)
                
                # 检查是否为最佳模型
                if valid_metrics['valid_loss'] < self.best_loss:
                    self.best_loss = valid_metrics['valid_loss']
                    self.patience_counter = 0
                    
                    self.save_checkpoint(epoch, is_best=True)
                else:
                    self.patience_counter += 1
                    
                    # 早停
                    if self.patience_counter >= self.config['training']['early_stopping_patience']:
                        logger.info(f"早停触发 (耐心值: {self.patience_counter})")
                        break
            
            # 定期保存检查点
            if (epoch + 1) % self.config['training']['check_interval'] == 0:
                self.save_checkpoint(epoch)
        
        # 在测试集上评估
        logger.info("\n" + "=" * 60)
        logger.info("最终评估")
        logger.info("=" * 60)
        test_metrics = self.test()
        logger.info(f"Test Metrics:")
        for key, value in test_metrics.items():
            logger.info(f"  {key}: {value:.4f}")
        
        self.writer.close()
        logger.info("训练完成!")


def main():
    """主训练函数"""
    # 加载配置
    with open('./configs/config.yaml', 'r', encoding='utf-8') as f:
        config = yaml.safe_load(f)
    
    # 配置日志
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        handlers=[
            logging.FileHandler('./logs/training.log'),
            logging.StreamHandler()
        ]
    )
    
    # 创建训练器
    trainer = Trainer(config, device=config['training']['device'])
    
    # 开始训练
    trainer.train(config['training']['num_epochs'])


if __name__ == "__main__":
    main()