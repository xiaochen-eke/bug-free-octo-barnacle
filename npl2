def prepare_huggingface_data(dataset_name='imdb', use_chinese=False, max_samples=None):
    """
    从 HuggingFace 准备数据集并划分
    
    Args:
        dataset_name (str): 数据集名称
        use_chinese (bool): 是否使用中文数据集
        max_samples (int): 最大样本数（用于快速测试）
        
    Returns:
        tuple: (训练文本, 训练标签, 验证文本, 验证标签, 测试文本, 测试标签)
    """
    
    # 加载训练数据
    train_texts, train_labels = load_huggingface_dataset(
        dataset_name=dataset_name,
        split='train',
        use_chinese=use_chinese
    )
    
