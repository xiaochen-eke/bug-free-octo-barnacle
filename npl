import torch
import numpy as np
import pandas as pd
from torch.utils.data import Dataset, DataLoader
from transformers import BertTokenizer, BertForSequenceClassification, AdamW
from transformers import get_linear_schedule_with_warmup
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
import warnings
warnings.filterwarnings('ignore')

# ============================================================================
# 第一部分：数据集定义
# ============================================================================

class TextClassificationDataset(Dataset):
    """
    文本分类数据集类
    用于加载和处理文本分类任务的数据
    """
    
    def __init__(self, texts, labels, tokenizer, max_len=128):
        """
        初始化数据集
        
        Args:
            texts (list): 文本列表
            labels (list): 标签列表
            tokenizer: BERT分词器
            max_len (int): 最大序列长度
        """
        self.texts = texts
        self.labels = labels
        self.tokenizer = tokenizer
        self.max_len = max_len
    
    def __len__(self):
        """返回数据集大小"""
        return len(self.texts)
    
    def __getitem__(self, idx):
        """
        获取单个样本
        
        Args:
            idx (int): 样本索引
            
        Returns:
            dict: 包含input_ids、attention_mask和labels的字典
        """
        text = self.texts[idx]
        label = self.labels[idx]
        
        # 使用tokenizer对文本进行编码
        encoding = self.tokenizer.encode_plus(
            text,
            add_special_tokens=True,  # 添加[CLS]和[SEP]标签
            max_length=self.max_len,
            return_token_type_ids=False,
            padding='max_length',  # 填充到max_length
            truncation=True,  # 截断超长文本
            return_attention_mask=True,  # 返回attention mask
            return_tensors='pt'  # 返回PyTorch张量
        )
        
        return {
            'input_ids': encoding['input_ids'].flatten(),
            'attention_mask': encoding['attention_mask'].flatten(),
            'labels': torch.tensor(label, dtype=torch.long)
        }


# ============================================================================
# 第二部分：模型配置和初始化
# ============================================================================

class BertForTextClassification:
    """
    BERT文本分类模型的包装类
    负责模型的加载、配置、训练和推理
    """
    
    def __init__(self, model_name='bert-base-chinese', num_classes=2, device='cpu'):
        """
        初始化模型
        
        Args:
            model_name (str): HuggingFace模型名称
            num_classes (int): 分类类别数
            device (str): 计算设备('cuda'或'cpu')
        """
        self.device = device
        self.model_name = model_name
        self.num_classes = num_classes
        
        # 加载预训练BERT模型和分词器
        print(f"正在加载 {model_name} 模型...")
        self.tokenizer = BertTokenizer.from_pretrained(model_name)
        self.model = BertForSequenceClassification.from_pretrained(
            model_name,
            num_labels=num_classes
        )
        self.model.to(device)
        print("模型加载完成！")
    
    def configure_optimizer(self, learning_rate=2e-5, weight_decay=0.01):
        """
        配置优化器（AdamW）
        
        Args:
            learning_rate (float): 学习率
            weight_decay (float): 权重衰减
            
        Returns:
            optimizer: 配置好的优化器
        """
        # 获取模型参数
        param_optimizer = list(self.model.named_parameters())
        
        # 分离需要衰减和不需要衰减的参数
        no_decay = ['bias', 'LayerNorm.weight']
        optimizer_grouped_parameters = [
            {
                'params': [p for n, p in param_optimizer if not any(nd in n for nd in no_decay)],
                'weight_decay': weight_decay
            },
            {
                'params': [p for n, p in param_optimizer if any(nd in n for nd in no_decay)],
                'weight_decay': 0.0
            }
        ]
        
        optimizer = AdamW(optimizer_grouped_parameters, lr=learning_rate)
        return optimizer
    
    def train_epoch(self, train_dataloader, optimizer, scheduler):
        """
        训练一个epoch
        
        Args:
            train_dataloader: 训练数据加载器
            optimizer: 优化器
            scheduler: 学习率调度器
            
        Returns:
            float: 当前epoch的平均损失
        """
        self.model.train()
        total_loss = 0.0
        
        for batch in train_dataloader:
            # 将数据移动到设备上
            input_ids = batch['input_ids'].to(self.device)
            attention_mask = batch['attention_mask'].to(self.device)
            labels = batch['labels'].to(self.device)
            
            # 清空梯度
            optimizer.zero_grad()
            
            # 前向传播
            outputs = self.model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                labels=labels
            )
            loss = outputs.loss
            
            # 反向传播
            loss.backward()
            
            # 梯度裁剪（防止梯度爆炸）
            torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=1.0)
            
            # 优化器步进
            optimizer.step()
            scheduler.step()
            
            total_loss += loss.item()
        
        avg_loss = total_loss / len(train_dataloader)
        return avg_loss
    
    def evaluate(self, eval_dataloader):
        """
        在验证集或测试集上评估模型
        
        Args:
            eval_dataloader: 验证/测试数据加载器
            
        Returns:
            tuple: (平均损失, 准确率, F1分数)
        """
        self.model.eval()
        total_loss = 0.0
        predictions = []
        true_labels = []
        
        with torch.no_grad():
            for batch in eval_dataloader:
                input_ids = batch['input_ids'].to(self.device)
                attention_mask = batch['attention_mask'].to(self.device)
                labels = batch['labels'].to(self.device)
                
                outputs = self.model(
                    input_ids=input_ids,
                    attention_mask=attention_mask,
                    labels=labels
                )
                loss = outputs.loss
                logits = outputs.logits
                
                total_loss += loss.item()
                
                # 获取预测结果
                preds = torch.argmax(logits, dim=1)
                predictions.extend(preds.cpu().numpy())
                true_labels.extend(labels.cpu().numpy())
        
        avg_loss = total_loss / len(eval_dataloader)
        accuracy = accuracy_score(true_labels, predictions)
        f1 = f1_score(true_labels, predictions, average='weighted')
        
        return avg_loss, accuracy, f1
    
    def train(self, train_dataloader, val_dataloader, epochs=3, learning_rate=2e-5):
        """
        完整的训练流程
        
        Args:
            train_dataloader: 训练数据加载器
            val_dataloader: 验证数据加载器
            epochs (int): 训练轮次
            learning_rate (float): 学习率
        """
        # 配置优化器和学习率调度器
        optimizer = self.configure_optimizer(learning_rate=learning_rate)
        
        # 计算总训练步数
        total_steps = len(train_dataloader) * epochs
        
        # 配置学习率预热和线性衰减调度
        scheduler = get_linear_schedule_with_warmup(
            optimizer,
            num_warmup_steps=0,
            num_training_steps=total_steps
        )
        
        print(f"\n开始训练 {epochs} 个epoch...")
        print("=" * 80)
        
        for epoch in range(epochs):
            print(f"\nEpoch {epoch + 1}/{epochs}")
            print("-" * 80)
            
            # 训练
            train_loss = self.train_epoch(train_dataloader, optimizer, scheduler)
            print(f"训练损失: {train_loss:.4f}")
            
            # 验证
            val_loss, val_accuracy, val_f1 = self.evaluate(val_dataloader)
            print(f"验证损失: {val_loss:.4f} | 准确率: {val_accuracy:.4f} | F1分数: {val_f1:.4f}")
        
        print("\n训练完成！")
        print("=" * 80)
    
    def predict(self, texts, batch_size=32):
        """
        对新样本进行预测推理
        
        Args:
            texts (list): 待预测的文本列表
            batch_size (int): 批处理大小
            
        Returns:
            list: 预测结果列表
        """
        self.model.eval()
        predictions = []
        
        # 创建临时数据集和数据加载器
        dummy_labels = [0] * len(texts)
        dataset = TextClassificationDataset(texts, dummy_labels, self.tokenizer)
        dataloader = DataLoader(dataset, batch_size=batch_size)
        
        with torch.no_grad():
            for batch in dataloader:
                input_ids = batch['input_ids'].to(self.device)
                attention_mask = batch['attention_mask'].to(self.device)
                
                outputs = self.model(
                    input_ids=input_ids,
                    attention_mask=attention_mask
                )
                logits = outputs.logits
                
                # 获取预测结果（概率最大的类别）
                preds = torch.argmax(logits, dim=1)
                predictions.extend(preds.cpu().numpy())
        
        return predictions
    
    def save_model(self, save_path):
        """
        保存微调后的模型
        
        Args:
            save_path (str): 保存路径
        """
        print(f"正在保存模型到 {save_path}...")
        self.model.save_pretrained(save_path)
        self.tokenizer.save_pretrained(save_path)
        print("模型保存成功！")
    
    def load_model(self, model_path):
        """
        加载已保存的模型
        
        Args:
            model_path (str): 模型路径
        """
        print(f"正在加载模型从 {model_path}...")
        self.model = BertForSequenceClassification.from_pretrained(model_path)
        self.tokenizer = BertTokenizer.from_pretrained(model_path)
        self.model.to(self.device)
        print("模型加载成功！")


# ============================================================================
# 第三部分：数据生成与处理
# ============================================================================

def generate_sample_data():
    """
    生成样本数据集（情感分析任务）
    
    返回：
        tuple: (训练文本, 训练标签, 验证文本, 验证标签, 测试文本, 测试标签)
    """
    # 积极评论
    positive_texts = [
        "这个产品质量真的很好，非常满意！",
        "服务态度很好，推荐给大家。",
        "性价比很高，值得购买。",
        "快递很快，包装也很用心。",
        "客服很有耐心，问题解决得很快。",
        "产品做工精细，超出预期。",
        "这是我买过最好的商品。",
        "质量一流，非常专业。",
    ]
    
    # 消极评论
    negative_texts = [
        "产品质量太差了，不值这个价。",
        "服务态度很恶劣，不推荐。",
        "描述和实物不符，很失望。",
        "快递太慢了，已经等了半个月。",
        "客服态度不好，问题还没解决。",
        "做工粗糙，用了一天就坏了。",
        "这是最差的购物体验。",
        "质量很一般，浪费钱。",
    ]
    
    # 创建完整数据集
    all_texts = positive_texts * 3 + negative_texts * 3
    all_labels = [1] * (len(positive_texts) * 3) + [0] * (len(negative_texts) * 3)
    
    # 打乱顺序
    indices = np.random.permutation(len(all_texts))
    all_texts = [all_texts[i] for i in indices]
    all_labels = [all_labels[i] for i in indices]
    
    # 划分训练集、验证集、测试集 (6:2:2)
    total_size = len(all_texts)
    train_size = int(total_size * 0.6)
    val_size = int(total_size * 0.2)
    
    train_texts = all_texts[:train_size]
    train_labels = all_labels[:train_size]
    
    val_texts = all_texts[train_size:train_size + val_size]
    val_labels = all_labels[train_size:train_size + val_size]
    
    test_texts = all_texts[train_size + val_size:]
    test_labels = all_labels[train_size + val_size:]
    
    return train_texts, train_labels, val_texts, val_labels, test_texts, test_labels


# ============================================================================
# 第四部分：主程序
# ============================================================================

def main():
    """
    主程序：完整的BERT微调流程
    """
    
    print("=" * 80)
    print("BERT 文本分类微调实验")
    print("=" * 80)
    
    # 1. 设备配置
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    print(f"\n使用设备: {device}")
    
    # 2. 加载预训练模型和分词器
    print("\n[步骤1] 加载预训练模型")
    model_wrapper = BertForTextClassification(
        model_name='bert-base-chinese',
        num_classes=2,  # 二分类：正面(1)和负面(0)
        device=device
    )
    
    # 3. 准备数据集
    print("\n[步骤2] 准备数据集")
    train_texts, train_labels, val_texts, val_labels, test_texts, test_labels = generate_sample_data()
    print(f"训练集大小: {len(train_texts)}")
    print(f"验证集大小: {len(val_texts)}")
    print(f"测试集大小: {len(test_texts)}")
    
    # 4. 创建数据加载器
    print("\n[步骤3] 创建数据加载器")
    batch_size = 16
    
    train_dataset = TextClassificationDataset(
        train_texts, train_labels, model_wrapper.tokenizer
    )
    train_dataloader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)
    
    val_dataset = TextClassificationDataset(
        val_texts, val_labels, model_wrapper.tokenizer
    )
    val_dataloader = DataLoader(val_dataset, batch_size=batch_size)
    
    test_dataset = TextClassificationDataset(
        test_texts, test_labels, model_wrapper.tokenizer
    )
    test_dataloader = DataLoader(test_dataset, batch_size=batch_size)
    
    # 5. 微调训练
    print("\n[步骤4] 微调训练")
    model_wrapper.train(
        train_dataloader=train_dataloader,
        val_dataloader=val_dataloader,
        epochs=3,
        learning_rate=2e-5
    )
    
    # 6. 测试集评估
    print("\n[步骤5] 在测试集上评估模型")
    test_loss, test_accuracy, test_f1 = model_wrapper.evaluate(test_dataloader)
    print(f"\n测试集结果:")
    print(f"  损失: {test_loss:.4f}")
    print(f"  准确率: {test_accuracy:.4f}")
    print(f"  F1分数: {test_f1:.4f}")
    
    # 7. 预测推理
    print("\n[步骤6] 使用微调后的模型进行预测")
    test_samples = [
        "这个产品质量非常好，我非常满意！",
        "服务太差了，不推荐购买。",
        "价格合理，做工精细，值得购买。",
    ]
    
    predictions = model_wrapper.predict(test_samples)
    labels_map = {0: "负面评价", 1: "正面评价"}
    
    print("\n预测结果:")
    for text, pred in zip(test_samples, predictions):
        print(f"  文本: {text}")
        print(f"  预测: {labels_map[pred]}\n")
    
    # 8. 保存模型
    print("[步骤7] 保存微调后的模型")
    save_path = './bert_finetuned_model'
    model_wrapper.save_model(save_path)
    
    # 9. 加载模型（演示模型复用）
    print("\n[步骤8] 演示模型加载与复用")
    new_model = BertForTextClassification(device=device)
    new_model.load_model(save_path)
    
    # 用加载的模型进行预测
    new_predictions = new_model.predict(test_samples)
    print("\n用加载的模型进行预测:")
    for text, pred in zip(test_samples, new_predictions):
        print(f"  文本: {text}")
        print(f"  预测: {labels_map[pred]}\n")
    
    print("=" * 80)
    print("实验完成！")
    print("=" * 80)


if __name__ == '__main__':
    main()