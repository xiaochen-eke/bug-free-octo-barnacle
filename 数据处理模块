"""
数据处理模块 - 包含分词、词汇表构建、数据集管理等功能
"""

import re
import json
from collections import Counter
from typing import List, Dict, Tuple
import torch
from torch.utils.data import Dataset, DataLoader
from torch.nn.utils.rnn import pad_sequence


class Tokenizer:
    """分词器 - 处理文本分词和编码"""
    
    def __init__(self, vocab_dict=None, unk_token='<unk>', 
                 pad_token='<pad>', bos_token='<bos>', eos_token='<eos>'):
        """
        初始化分词器
        
        参数:
            vocab_dict: 词汇表字典 {word: idx}
            unk_token: 未知词token
            pad_token: 填充token
            bos_token: 开始token
            eos_token: 结束token
        """
        self.vocab_dict = vocab_dict or {}
        self.unk_token = unk_token
        self.pad_token = pad_token
        self.bos_token = bos_token
        self.eos_token = eos_token
        
        # 创建反向词汇表
        self.idx_to_word = {v: k for k, v in self.vocab_dict.items()}
    
    def tokenize(self, text: str) -> List[str]:
        """
        分词处理 - 将文本分割成词元
        
        参数:
            text: 输入文本
        
        返回:
            词元列表
        """
        # 转换为小写并进行基本清理
        text = text.lower().strip()
        
        # 使用正则表达式进行分词
        # 保留字母、数字和中文字符，分离标点符号
        text = re.sub(r'([\.,!?;:\-\(\)])', r' \1 ', text)
        tokens = text.split()
        
        return tokens
    
    def encode(self, text: str, add_bos=False, add_eos=True) -> List[int]:
        """
        将文本编码为索引序列
        
        参数:
            text: 输入文本
            add_bos: 是否添加开始token
            add_eos: 是否添加结束token
        
        返回:
            索引列表
        """
        tokens = self.tokenize(text)
        
        # 获取词汇表大小
        vocab_size = len(self.vocab_dict)
        
        # 构建编码序列
        indices = []
        
        if add_bos and self.bos_token in self.vocab_dict:
            indices.append(self.vocab_dict[self.bos_token])
        
        for token in tokens:
            if token in self.vocab_dict:
                indices.append(self.vocab_dict[token])
            else:
                # 未知词使用<unk> token
                indices.append(self.vocab_dict.get(self.unk_token, vocab_size - 1))
        
        if add_eos and self.eos_token in self.vocab_dict:
            indices.append(self.vocab_dict[self.eos_token])
        
        return indices
    
    def decode(self, indices: List[int]) -> str:
        """
        将索引序列解码为文本
        
        参数:
            indices: 索引列表
        
        返回:
            解码文本
        """
        tokens = []
        for idx in indices:
            if idx in self.idx_to_word:
                token = self.idx_to_word[idx]
                # 跳过特殊tokens
                if token not in [self.pad_token, self.bos_token]:
                    tokens.append(token)
                if token == self.eos_token:
                    break
        
        return ' '.join(tokens)
    
    def get_vocab_size(self) -> int:
        """获取词汇表大小"""
        return len(self.vocab_dict)


class VocabBuilder:
    """词汇表构建器 - 从语料库构建词汇表"""
    
    def __init__(self, min_freq=1, special_tokens=None):
        """
        初始化词汇表构建器
        
        参数:
            min_freq: 最小频率阈值 (低于此频率的词不包含)
            special_tokens: 特殊tokens列表
        """
        self.min_freq = min_freq
        self.special_tokens = special_tokens or ['<unk>', '<pad>', '<bos>', '<eos>']
        self.word_freq = Counter()
    
    def build_vocab(self, texts: List[str], tokenizer_func=None) -> Dict[str, int]:
        """
        从文本列表构建词汇表
        
        参数:
            texts: 文本列表
            tokenizer_func: 分词函数 (如果为None, 使用默认分词)
        
        返回:
            词汇表字典 {word: idx}
        """
        if tokenizer_func is None:
            tokenizer_func = lambda text: text.lower().split()
        
        # 计数词频
        for text in texts:
            tokens = tokenizer_func(text)
            self.word_freq.update(tokens)
        
        # 构建词汇表
        vocab_dict = {}
        
        # 首先添加特殊tokens
        idx = 0
        for token in self.special_tokens:
            vocab_dict[token] = idx
            idx += 1
        
        # 按频率排序并添加词汇
        for word, freq in self.word_freq.most_common():
            if freq >= self.min_freq and word not in vocab_dict:
                vocab_dict[word] = idx
                idx += 1
        
        return vocab_dict


class TranslationDataset(Dataset):
    """翻译数据集 - 用于训练/验证/测试"""
    
    def __init__(self, src_texts: List[str], tgt_texts: List[str],
                 src_tokenizer: Tokenizer, tgt_tokenizer: Tokenizer,
                 max_length: int = 100):
        """
        初始化翻译数据集
        
        参数:
            src_texts: 源语言文本列表
            tgt_texts: 目标语言文本列表
            src_tokenizer: 源语言分词器
            tgt_tokenizer: 目标语言分词器
            max_length: 最大序列长度 (超过此长度的样本会被截断)
        """
        assert len(src_texts) == len(tgt_texts), "源文本和目标文本数量必须相同"
        
        self.src_texts = src_texts
        self.tgt_texts = tgt_texts
        self.src_tokenizer = src_tokenizer
        self.tgt_tokenizer = tgt_tokenizer
        self.max_length = max_length
    
    def __len__(self) -> int:
        """返回数据集大小"""
        return len(self.src_texts)
    
    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        """
        获取单个样本
        
        参数:
            idx: 索引
        
        返回:
            (源序列张量, 目标序列张量, 目标序列输出标签)
        """
        src_text = self.src_texts[idx]
        tgt_text = self.tgt_texts[idx]
        
        # 编码源文本 (不添加BOS, 添加EOS)
        src_indices = self.src_tokenizer.encode(src_text, add_bos=False, add_eos=True)
        
        # 编码目标文本 (添加BOS, 用于解码器输入)
        tgt_indices = self.tgt_tokenizer.encode(tgt_text, add_bos=True, add_eos=False)
        
        # 编码目标文本标签 (不添加BOS, 添加EOS)
        tgt_label_indices = self.tgt_tokenizer.encode(tgt_text, add_bos=False, add_eos=True)
        
        # 限制最大长度
        src_indices = src_indices[:self.max_length]
        tgt_indices = tgt_indices[:self.max_length]
        tgt_label_indices = tgt_label_indices[:self.max_length]
        
        # 转换为张量
        src_tensor = torch.tensor(src_indices, dtype=torch.long)
        tgt_tensor = torch.tensor(tgt_indices, dtype=torch.long)
        tgt_label_tensor = torch.tensor(tgt_label_indices, dtype=torch.long)
        
        return src_tensor, tgt_tensor, tgt_label_tensor


def create_batch_collate_fn(pad_idx: int = 0):
    """
    创建批处理整合函数 - 将不同长度的序列填充到相同长度
    
    参数:
        pad_idx: 填充token索引
    
    返回:
        批处理整合函数
    """
    def collate_fn(batch):
        """
        批处理整合函数
        
        参数:
            batch: 样本列表 [(src, tgt, label), ...]
        
        返回:
            批处理张量 (src_batch, tgt_batch, label_batch, src_mask, tgt_mask)
        """
        src_tensors, tgt_tensors, label_tensors = zip(*batch)
        
        # 填充序列
        src_batch = pad_sequence(src_tensors, batch_first=True, padding_value=pad_idx)
        tgt_batch = pad_sequence(tgt_tensors, batch_first=True, padding_value=pad_idx)
        label_batch = pad_sequence(label_tensors, batch_first=True, padding_value=pad_idx)
        
        # 创建掩码 (1表示真实token, 0表示填充token)
        src_mask = (src_batch != pad_idx).float()
        tgt_mask = (tgt_batch != pad_idx).float()
        
        return {
            'src': src_batch,
            'tgt': tgt_batch,
            'label': label_batch,
            'src_mask': src_mask,
            'tgt_mask': tgt_mask
        }
    
    return collate_fn


def create_dataloaders(src_texts: List[str], tgt_texts: List[str],
                       src_tokenizer: Tokenizer, tgt_tokenizer: Tokenizer,
                       batch_size: int = 32, max_length: int = 100,
                       train_ratio: float = 0.8, val_ratio: float = 0.1,
                       shuffle: bool = True) -> Tuple[DataLoader, DataLoader, DataLoader]:
    """
    创建训练、验证、测试数据加载器
    
    参数:
        src_texts: 源语言文本列表
        tgt_texts: 目标语言文本列表
        src_tokenizer: 源语言分词器
        tgt_tokenizer: 目标语言分词器
        batch_size: 批大小
        max_length: 最大序列长度
        train_ratio: 训练集比例
        val_ratio: 验证集比例
        shuffle: 是否打乱数据
    
    返回:
        (训练加载器, 验证加载器, 测试加载器)
    """
    # 计算数据集大小
    total_size = len(src_texts)
    train_size = int(total_size * train_ratio)
    val_size = int(total_size * val_ratio)
    test_size = total_size - train_size - val_size
    
    # 生成索引并打乱
    indices = list(range(total_size))
    if shuffle:
        import random
        random.shuffle(indices)
    
    # 分割数据
    train_indices = indices[:train_size]
    val_indices = indices[train_size:train_size + val_size]
    test_indices = indices[train_size + val_size:]
    
    # 创建数据集
    train_src = [src_texts[i] for i in train_indices]
    train_tgt = [tgt_texts[i] for i in train_indices]
    train_dataset = TranslationDataset(train_src, train_tgt, 
                                       src_tokenizer, tgt_tokenizer, max_length)
    
    val_src = [src_texts[i] for i in val_indices]
    val_tgt = [tgt_texts[i] for i in val_indices]
    val_dataset = TranslationDataset(val_src, val_tgt,
                                     src_tokenizer, tgt_tokenizer, max_length)
    
    test_src = [src_texts[i] for i in test_indices]
    test_tgt = [tgt_texts[i] for i in test_indices]
    test_dataset = TranslationDataset(test_src, test_tgt,
                                      src_tokenizer, tgt_tokenizer, max_length)
    
    # 创建数据加载器
    collate_fn = create_batch_collate_fn(pad_idx=src_tokenizer.vocab_dict.get('<pad>', 0))
    
    train_loader = DataLoader(train_dataset, batch_size=batch_size,
                             shuffle=True, collate_fn=collate_fn)
    val_loader = DataLoader(val_dataset, batch_size=batch_size,
                           shuffle=False, collate_fn=collate_fn)
    test_loader = DataLoader(test_dataset, batch_size=batch_size,
                            shuffle=False, collate_fn=collate_fn)
    
    return train_loader, val_loader, test_loader


def save_tokenizers(src_tokenizer: Tokenizer, tgt_tokenizer: Tokenizer, path: str):
    """
    保存分词器
    
    参数:
        src_tokenizer: 源语言分词器
        tgt_tokenizer: 目标语言分词器
        path: 保存路径 (不包含文件后缀)
    """
    import json
    
    # 保存源语言分词器
    with open(f'{path}_src.json', 'w', encoding='utf-8') as f:
        json.dump(src_tokenizer.vocab_dict, f, ensure_ascii=False, indent=2)
    
    # 保存目标语言分词器
    with open(f'{path}_tgt.json', 'w', encoding='utf-8') as f:
        json.dump(tgt_tokenizer.vocab_dict, f, ensure_ascii=False, indent=2)


def load_tokenizers(path: str) -> Tuple[Tokenizer, Tokenizer]:
    """
    加载分词器
    
    参数:
        path: 保存路径 (不包含文件后缀)
    
    返回:
        (源语言分词器, 目标语言分词器)
    """
    import json
    
    # 加载源语言分词器
    with open(f'{path}_src.json', 'r', encoding='utf-8') as f:
        src_vocab = json.load(f)
    
    # 加载目标语言分词器
    with open(f'{path}_tgt.json', 'r', encoding='utf-8') as f:
        tgt_vocab = json.load(f)
    
    src_tokenizer = Tokenizer(src_vocab)
    tgt_tokenizer = Tokenizer(tgt_vocab)
    
    return src_tokenizer, tgt_tokenizer